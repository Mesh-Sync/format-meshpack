export type HashAlgorithm = "sha256" | "sha512" | "blake3";

export interface MeshPackDocument {
  manifest: Manifest;
  shards: Shard[];
  entries: FileEntry[];
}

export interface MeshPackValidationResult {
  valid: boolean;
  findings: MeshPackValidationFinding[];
  errors: MeshPackValidationFinding[];
  warnings: MeshPackValidationFinding[];
}

export interface MeshPackValidationOptions {
  sidecar?: Sidecar | string | Uint8Array | ArrayBuffer;
  archiveName?: string;
  verifySignatures?: boolean;
}

export interface MeshPackValidationFinding {
  severity: "ERROR" | "WARNING" | "INFO";
  code: string;
  message: string;
}

export interface WriteMeshPackInput {
  manifest: Manifest;
  shards: Shard[];
  resources?: Record<string, Uint8Array | ArrayBuffer | string>;
}

export class MeshPackReader {
  private zip: JSZip = new JSZip();
  private manifest: Manifest | null = null;
  private shards: Shard[] = [];
  private fileMap: Map<string, FileEntry> = new Map();
  private loaded = false;

  async loadAsync(data: ArrayBuffer | Uint8Array): Promise<void> {
    if (this.loaded) {
      return;
    }

    await this.zip.loadAsync(data);
    const manifestFile = this.zip.file("manifest.json");
    if (!manifestFile) {
      throw new Error("manifest.json not found in archive");
    }

    this.manifest = JSON.parse(await manifestFile.async("string")) as Manifest;

    for (const shardRef of this.manifest.shard_list ?? []) {
      const shardPath = `index/${shardRef.id}.json`;
      const shardFile = this.zip.file(shardPath);
      if (!shardFile) {
        throw new Error(`Shard file missing in archive: ${shardPath}`);
      }
      const shard = JSON.parse(await shardFile.async("string")) as Shard;
      this.shards.push(shard);
      for (const entry of shard.entries) {
        this.fileMap.set(entry.path, entry);
      }
    }

    this.loaded = true;
  }

  getManifest(): Manifest | null {
    return this.manifest;
  }

  getShards(): Shard[] {
    return [...this.shards];
  }

  getEntries(): FileEntry[] {
    return Array.from(this.fileMap.values());
  }

  getFileEntry(path: string): FileEntry | undefined {
    return this.fileMap.get(path);
  }

  listModelEntries(): FileEntry[] {
    return listModelEntries(this.getEntries());
  }

  getFilesByHash(hash: string): FileEntry[] {
    return this.getEntries().filter((entry) => entry.hash === hash);
  }

  listByExtension(extensions: string[]): FileEntry[] {
    const normalized = extensions.map((extension) => extension.toLowerCase());
    return this.getEntries().filter((entry) => {
      const lower = entry.path.toLowerCase();
      return normalized.some((extension) => lower.endsWith(extension));
    });
  }

  async readResourceAsync(entry: FileEntry, type: "arraybuffer" | "uint8array" | "string" = "uint8array"): Promise<ArrayBuffer | Uint8Array | string | null> {
    if (!entry.resource_ref) {
      return null;
    }
    if (!isSafeResourceRef(entry.resource_ref)) {
      return null;
    }
    const file = this.zip.file(`resources/${entry.resource_ref}`);
    return file ? file.async(type) : null;
  }

  validateIntegrity(): string[] {
    const missing: string[] = [];
    for (const entry of this.fileMap.values()) {
      if (entry.resource_ref && !isSafeResourceRef(entry.resource_ref)) {
        missing.push(entry.path);
        continue;
      }
      if (entry.resource_ref && !this.zip.file(`resources/${entry.resource_ref}`)) {
        missing.push(entry.path);
      }
    }
    return missing;
  }
}

export async function readMeshPack(data: ArrayBuffer | Uint8Array): Promise<MeshPackDocument> {
  const reader = new MeshPackReader();
  await reader.loadAsync(data);
  const manifest = reader.getManifest();
  if (!manifest) {
    throw new Error("manifest.json not loaded");
  }
  return {
    manifest,
    shards: reader.getShards(),
    entries: reader.getEntries(),
  };
}

export async function writeMeshPack(input: WriteMeshPackInput): Promise<Uint8Array> {
  const zip = new JSZip();
  zip.file("manifest.json", `${JSON.stringify(input.manifest, null, 2)}\n`);

  for (const shard of input.shards) {
    zip.file(`index/${shard.shard_id}.json`, `${JSON.stringify(shard, null, 2)}\n`);
  }

  for (const [name, content] of Object.entries(input.resources ?? {})) {
    if (!isSafeResourceRef(name)) {
      throw new Error(`Unsafe or non-canonical resource name: ${name}`);
    }
    zip.file(`resources/${name}`, content);
  }

  return zip.generateAsync({ type: "uint8array", compression: "DEFLATE" });
}

export async function validateMeshPack(
  data: ArrayBuffer | Uint8Array,
  options: MeshPackValidationOptions = {}
): Promise<MeshPackValidationResult> {
  const findings: MeshPackValidationFinding[] = [];
  try {
    const zip = await JSZip.loadAsync(data);
    const names = Object.keys(zip.files);
    const namesSet = new Set(names);
    if (names.length > 0 && names[0] !== "manifest.json") {
      findings.push(finding("WARNING", "ZIP-001", `manifest.json should be the first ZIP entry (found '${names[0]}' first)`));
    }

    const document = await readMeshPack(data);
    const manifest = document.manifest;
    if (document.entries.length !== document.manifest.index_summary.total_files) {
      findings.push(finding("WARNING", "MAN-015", "manifest index_summary.total_files does not match loaded entry count"));
    }
    if (document.shards.length !== document.manifest.index_summary.total_shards) {
      findings.push(finding("WARNING", "MAN-015", "manifest index_summary.total_shards does not match loaded shard count"));
    }
    if (!Array.isArray(manifest.shard_list) || manifest.shard_list.length === 0) {
      findings.push(finding("ERROR", "MAN-014", "shard_list must be a non-empty array"));
    }
    if (!["sha256", "sha512", "blake3"].includes(manifest.hash_algo)) {
      findings.push(finding("ERROR", "MAN-012", `Unsupported hash_algo: '${manifest.hash_algo}'`));
    }

    for (const shardRef of manifest.shard_list ?? []) {
      const shardPath = `index/${shardRef.id}.json`;
      if (!/^part-\d{5}$/.test(shardRef.id)) {
        findings.push(finding("WARNING", "SHD-001", `shard_id '${shardRef.id}' does not match ^part-\\d{5}$`));
      }
      if (!namesSet.has(shardPath)) {
        findings.push(finding("ERROR", "SHD-002", `Shard file missing in archive: ${shardPath}`));
        continue;
      }
      const shard = document.shards.find((candidate) => candidate.shard_id === shardRef.id);
      if (!shard) {
        findings.push(finding("ERROR", "SHD-003", `Failed to parse ${shardPath}`));
        continue;
      }
      const paths = shard.entries.map((entry) => entry.path);
      if (JSON.stringify(paths) !== JSON.stringify([...paths].sort())) {
        findings.push(finding("WARNING", "SHD-004", `Entries not sorted by path in ${shardPath}`));
      }
      if (shardRef.entries_count !== shard.entries.length) {
        findings.push(finding("ERROR", "SHD-005", `entries_count mismatch in ${shardPath}: expected ${shardRef.entries_count}, got ${shard.entries.length}`));
      }
      if (shardRef.entries_hash) {
        try {
          const actualHash = computeEntriesHash(shard.entries, manifest.hash_algo as HashAlgorithm);
          if (actualHash !== shardRef.entries_hash) {
            findings.push(finding("ERROR", "SHD-007", `entries_hash mismatch in ${shardPath}: expected ${shardRef.entries_hash}, got ${actualHash}`));
          }
        } catch (error) {
          findings.push(finding("WARNING", "SHD-006", `Hash algo error in ${shardPath}: ${error instanceof Error ? error.message : String(error)}`));
        }
      }

      for (const entry of shard.entries) {
        findings.push(...validateEntry(entry, shardPath));
        if (entry.resource_ref && !entry.resource_hash) {
          findings.push(finding("WARNING", "RES-001", `${shardPath}:${entry.path} has resource_ref but missing resource_hash`));
        }
        findings.push(...validateResourceRef(entry.resource_ref, "resource_ref", shardPath, entry.path));
        if (entry.resource_ref && !namesSet.has(`resources/${entry.resource_ref}`)) {
          findings.push(finding("ERROR", "RES-002", `Missing embedded resource: resources/${entry.resource_ref}`));
        }
        findings.push(...validateResourceRef(entry.preview_ref, "preview_ref", shardPath, entry.path));
        if (entry.preview_ref && !namesSet.has(`resources/${entry.preview_ref}`)) {
          findings.push(finding("ERROR", "RES-002", `Missing embedded resource: resources/${entry.preview_ref}`));
        }
      }
    }
    findings.push(...validateSidecar(data, manifest, options));
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    findings.push(finding(message.includes("manifest.json") ? "ERROR" : "ERROR", message.includes("manifest.json") ? "MAN-001" : "ARC-001", message));
  }
  const errors = findings.filter((item) => item.severity === "ERROR");
  const warnings = findings.filter((item) => item.severity === "WARNING");
  return { valid: errors.length === 0, findings, errors, warnings };
}

function finding(severity: MeshPackValidationFinding["severity"], code: string, message: string): MeshPackValidationFinding {
  return { severity, code, message };
}

function validateSidecar(
  archiveData: ArrayBuffer | Uint8Array,
  manifest: Manifest,
  options: MeshPackValidationOptions
): MeshPackValidationFinding[] {
  const findings: MeshPackValidationFinding[] = [];
  if (!options.sidecar) {
    return [finding("INFO", "SDC-001", "No .meshpack.integrity sidecar provided; skipping pack-level hash verification.")];
  }

  let sidecar: Sidecar;
  try {
    sidecar = parseSidecar(options.sidecar);
  } catch (error) {
    return [finding("ERROR", "SDC-002", `Failed to load sidecar: ${error instanceof Error ? error.message : String(error)}`)];
  }

  if (options.archiveName && sidecar.pack_name && sidecar.pack_name !== options.archiveName) {
    findings.push(finding("ERROR", "SDC-006", `Sidecar pack_name mismatch: sidecar expects ${sidecar.pack_name}, archive is ${options.archiveName}`));
  }

  const archiveBytes = toUint8Array(archiveData);
  if (typeof sidecar.pack_size_bytes === "number" && sidecar.pack_size_bytes !== archiveBytes.byteLength) {
    findings.push(finding("ERROR", "SDC-007", `Sidecar pack_size_bytes mismatch: sidecar expects ${sidecar.pack_size_bytes}, archive is ${archiveBytes.byteLength}`));
  }

  if (sidecar.hash_algo && manifest.hash_algo && sidecar.hash_algo !== manifest.hash_algo) {
    findings.push(finding("ERROR", "SDC-008", `Sidecar hash_algo mismatch: sidecar uses ${sidecar.hash_algo}, manifest uses ${manifest.hash_algo}`));
  }
  if (!sidecar.hash_algo || !sidecar.pack_hash) {
    findings.push(finding("WARNING", "SDC-003", "Sidecar missing hash_algo or pack_hash"));
    return findings;
  }

  try {
    const digest = computeDigest(archiveBytes, sidecar.hash_algo as HashAlgorithm);
    const actual = sidecar.pack_hash.includes(":") ? `${sidecar.hash_algo}:${digest}` : digest;
    if (actual !== sidecar.pack_hash) {
      findings.push(finding("ERROR", "SDC-005", `Pack hash mismatch: sidecar expects ${sidecar.pack_hash}, computed ${actual}`));
    } else {
      findings.push(finding("INFO", "SDC-010", "Pack hash verified successfully via sidecar."));
    }
  } catch (error) {
    findings.push(finding("WARNING", "SDC-004", error instanceof Error ? error.message : String(error)));
    return findings;
  }

  if (sidecar.signatures && sidecar.signatures.length > 0 && options.verifySignatures) {
    findings.push(...verifySignatureEntries(sidecar.signatures, sidecar.pack_hash));
  } else if (sidecar.signatures && sidecar.signatures.length > 0) {
    findings.push(finding("INFO", "SDC-011", `Sidecar contains ${sidecar.signatures.length} signature(s). Enable signature verification to check them.`));
  }
  return findings;
}

function parseSidecar(sidecar: Sidecar | string | Uint8Array | ArrayBuffer): Sidecar {
  if (typeof sidecar === "string") {
    return JSON.parse(sidecar) as Sidecar;
  }
  if (sidecar instanceof ArrayBuffer || sidecar instanceof Uint8Array) {
    return JSON.parse(Buffer.from(toUint8Array(sidecar)).toString("utf8")) as Sidecar;
  }
  return sidecar;
}

function toUint8Array(data: ArrayBuffer | Uint8Array): Uint8Array {
  return data instanceof Uint8Array ? data : new Uint8Array(data);
}

function computeDigest(data: Uint8Array, hashAlgo: HashAlgorithm): string {
  if (hashAlgo === "blake3") {
    return bytesToHex(blake3(data));
  }
  return createHash(hashAlgo).update(Buffer.from(data)).digest("hex");
}

function bytesToHex(bytes: Uint8Array): string {
  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
}

function verifySignatureEntries(signatures: SignatureEntry[], packHash: string): MeshPackValidationFinding[] {
  const findings: MeshPackValidationFinding[] = [];
  const signedData = Buffer.from(packHash, "utf8");

  signatures.forEach((signatureEntry, index) => {
    const signer = signatureEntry.signer_id ?? `signature[${index}]`;
    if (!signatureEntry.alg || !signatureEntry.public_key || !signatureEntry.signature) {
      findings.push(finding("ERROR", "SIG-002", `${signer}: missing required field (alg/public_key/signature)`));
      return;
    }

    let publicKeyBytes: Buffer;
    let signatureBytes: Buffer;
    try {
      publicKeyBytes = Buffer.from(signatureEntry.public_key, "base64");
      signatureBytes = Buffer.from(signatureEntry.signature, "base64");
    } catch (error) {
      findings.push(finding("ERROR", "SIG-003", `${signer}: invalid base64 encoding - ${error instanceof Error ? error.message : String(error)}`));
      return;
    }

    try {
      if (signatureEntry.alg === "ed25519") {
        const keyBytes = publicKeyBytes.byteLength === 32
          ? Buffer.concat([Buffer.from("302a300506032b6570032100", "hex"), publicKeyBytes])
          : publicKeyBytes;
        const key = createPublicKey({ key: keyBytes, format: "der", type: "spki" });
        if (verifySignature(null, signedData, key, signatureBytes)) {
          findings.push(finding("INFO", "SIG-010", `${signer}: Ed25519 signature verified successfully`));
        } else {
          findings.push(finding("ERROR", "SIG-004", `${signer}: Ed25519 signature verification failed`));
        }
      } else if (signatureEntry.alg === "rsa-pss-sha256") {
        const key = createPublicKey({ key: publicKeyBytes, format: "der", type: "spki" });
        if (verifySignature("sha256", signedData, { key, padding: constants.RSA_PKCS1_PSS_PADDING, saltLength: constants.RSA_PSS_SALTLEN_MAX_SIGN }, signatureBytes)) {
          findings.push(finding("INFO", "SIG-010", `${signer}: RSA-PSS-SHA256 signature verified successfully`));
        } else {
          findings.push(finding("ERROR", "SIG-004", `${signer}: RSA-PSS-SHA256 signature verification failed`));
        }
      } else {
        findings.push(finding("INFO", "SIG-005", `${signer}: unsupported algorithm '${signatureEntry.alg}' - skipped`));
      }
    } catch (error) {
      findings.push(finding("ERROR", "SIG-004", `${signer}: ${signatureEntry.alg} signature verification failed - ${error instanceof Error ? error.message : String(error)}`));
    }
  });

  return findings;
}

function validateEntry(entry: FileEntry, shardPath: string): MeshPackValidationFinding[] {
  const findings: MeshPackValidationFinding[] = [];
  if (entry.path.length > 1024) {
    findings.push(finding("ERROR", "ENT-001", `Path exceeds 1024 chars in ${shardPath}: ${entry.path.slice(0, 80)}...`));
  }
  if (/(^|\/)\.\.(\/|$)/.test(entry.path)) {
    findings.push(finding("ERROR", "ENT-002", `Path traversal detected in ${shardPath}: ${entry.path}`));
  }
  if (entry.path.startsWith("/")) {
    findings.push(finding("ERROR", "ENT-003", `Absolute path in ${shardPath}: ${entry.path}`));
  }
  if (/^[A-Za-z]:/.test(entry.path)) {
    findings.push(finding("ERROR", "ENT-004", `Drive letter path in ${shardPath}: ${entry.path}`));
  }
  if (entry.path.startsWith("\\\\")) {
    findings.push(finding("ERROR", "ENT-005", `UNC path in ${shardPath}: ${entry.path}`));
  }
  if (entry.hash && !/^(sha256:[a-f0-9]{64}|sha512:[a-f0-9]{128}|blake3:[a-f0-9]{64})$/.test(entry.hash)) {
    findings.push(finding("WARNING", "HSH-001", `Hash format invalid for ${entry.path} in ${shardPath}`));
  }
  return findings;
}

function isSafeResourceRef(resourceRef: string): boolean {
  return RESOURCE_REF_PATTERN.test(resourceRef) && !/[\\/:]/.test(resourceRef);
}

function validateResourceRef(
  resourceRef: unknown,
  fieldName: string,
  shardPath: string,
  entryPath: string
): MeshPackValidationFinding[] {
  if (resourceRef === undefined || resourceRef === null || resourceRef === "") {
    return [];
  }
  if (typeof resourceRef !== "string") {
    return [finding("ERROR", "RES-004", `${fieldName} for ${shardPath}:${entryPath} must be a string`)];
  }
  const findings: MeshPackValidationFinding[] = [];
  if (resourceRef.includes(":")) {
    findings.push(finding("WARNING", "RES-003", `${fieldName} contains ':' in ${shardPath}:${entryPath}`));
  }
  if (!isSafeResourceRef(resourceRef)) {
    findings.push(finding("ERROR", "RES-004", `Unsafe or non-canonical ${fieldName} in ${shardPath}:${entryPath}: ${resourceRef}`));
  }
  return findings;
}

export function listModelEntries(entries: FileEntry[]): FileEntry[] {
  const modelExtensions = [".stl", ".obj", ".3mf", ".step", ".stp", ".ply", ".off"];
  return entries.filter((entry) => {
    const lower = entry.path.toLowerCase();
    return modelExtensions.some((extension) => lower.endsWith(extension));
  });
}

export function computeEntriesHash(entries: FileEntry[], hashAlgo: HashAlgorithm = "sha256"): string {
  const sortedEntries = [...entries].sort((a, b) => a.path.localeCompare(b.path));
  const digest = computeDigest(Buffer.from(canonicalStringify(sortedEntries), "utf8"), hashAlgo);
  return `${hashAlgo}:${digest}`;
}

export function canonicalStringify(value: unknown): string {
  if (value === null || typeof value !== "object") {
    return JSON.stringify(value);
  }
  if (Array.isArray(value)) {
    return `[${value.map((item) => canonicalStringify(item)).join(",")}]`;
  }
  const record = value as Record<string, unknown>;
  return `{${Object.keys(record).sort().map((key) => `${JSON.stringify(key)}:${canonicalStringify(record[key])}`).join(",")}}`;
}

export const ExtensionNames = {
