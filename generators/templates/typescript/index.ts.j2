{% endfor %}
} as const;

export const ExtensionVersions: Record<string, string[]> = {
{% for ext in extensions %}
  "{{ ext.name }}": {{ ext.versions | tojson }},
{% endfor %}
};

export function getExtensionVersion<T = Record<string, unknown>>(
  extensions: Record<string, unknown> | undefined,
  extName: string,
  version: string
): T | undefined {
  if (!extensions) {
    return undefined;
  }
  const extension = extensions[extName];
  if (!extension || typeof extension !== "object") {
    return undefined;
  }
  return (extension as Record<string, T>)[version];
}

export function getLatestExtension<T = Record<string, unknown>>(
  extensions: Record<string, unknown> | undefined,
  extName: string
): { version: string; data: T } | undefined {
  if (!extensions) {
    return undefined;
  }
  const extension = extensions[extName];
  if (!extension || typeof extension !== "object") {
    return undefined;
  }
  const versioned = extension as Record<string, T>;
  const versions = Object.keys(versioned)
    .filter((key) => key.startsWith("v") && !Number.isNaN(Number.parseInt(key.slice(1), 10)))
    .sort((a, b) => Number.parseInt(b.slice(1), 10) - Number.parseInt(a.slice(1), 10));
  return versions.length === 0 ? undefined : { version: versions[0], data: versioned[versions[0]] };
}

export function getBestExtension<T = Record<string, unknown>>(
  extensions: Record<string, unknown> | undefined,
  extName: string,
  maxVersion?: string
): { version: string; data: T } | undefined {
  if (!maxVersion) {
    return getLatestExtension<T>(extensions, extName);
  }
  if (!extensions) {
    return undefined;
  }
  const extension = extensions[extName];
  if (!extension || typeof extension !== "object") {
    return undefined;
  }
  const max = Number.parseInt(maxVersion.replace("v", ""), 10);
  const versioned = extension as Record<string, T>;
  const versions = Object.keys(versioned)
    .filter((key) => key.startsWith("v") && !Number.isNaN(Number.parseInt(key.slice(1), 10)))
    .filter((key) => Number.parseInt(key.slice(1), 10) <= max)
    .sort((a, b) => Number.parseInt(b.slice(1), 10) - Number.parseInt(a.slice(1), 10));
  return versions.length === 0 ? undefined : { version: versions[0], data: versioned[versions[0]] };
}

export function setExtension(
  extensions: Record<string, unknown>,
  extName: string,
  version: string,
  data: Record<string, unknown>
): Record<string, unknown> {
  const current = extensions[extName];
  const versioned = current && typeof current === "object" ? current as Record<string, unknown> : {};
  versioned[version] = data;
  extensions[extName] = versioned;
  return extensions;
}

