export class MeshPackReader {
    private zip: JSZip;
    private manifest: Manifest | null = null;
    private fileMap: Map<string, FileEntry> = new Map();
    private loaded: boolean = false;

    constructor() {
        this.zip = new JSZip();
    }

    async loadAsync(data: ArrayBuffer | Uint8Array): Promise<void> {
        if (this.loaded) return;

        await this.zip.loadAsync(data);
        
        // Manifest
        const manifestFile = this.zip.file("manifest.json");
        if (manifestFile) {
            const content = await manifestFile.async("string");
            this.manifest = JSON.parse(content) as Manifest;
        }

        // Shards
        const shardFiles = this.zip.file(/index\/.*\.json/);
        for (const f of shardFiles) {
            const content = await f.async("string");
            const shard = JSON.parse(content) as Shard;
            for (const entry of shard.entries) {
                this.fileMap.set(entry.path, entry);
            }
        }
        
        this.loaded = true;
    }

    getManifest(): Manifest | null {
        return this.manifest;
    }

    getFileEntry(path: string): FileEntry | undefined {
        return this.fileMap.get(path);
    }
    
    getModelsInstances(): FileEntry[] {
        const modelExts = [".stl", ".obj", ".3mf", ".step", ".stp", ".ply", ".off"];
        return this.listByExtension(modelExts);
    }

    /**
     * Reads the binary content of the associated resource.
     * @param entry The FileEntry to read the resource for.
     * @param type The output type format ("blob", "arraybuffer", "uint8array", etc). Defaults to "blob".
     */
    async readResourceAsync(entry: FileEntry, type: "blob" | "arraybuffer" | "uint8array" | "string" = "blob"): Promise<any> {
        if (!entry.resource_ref) return null;
        
        const path = `resources/${entry.resource_ref}`;
        const file = this.zip.file(path);
        
        if (!file) return null;
        return await file.async(type);
    }

    /**
     * Find files by exact content hash.
     */
    getFilesByHash(hash: string): FileEntry[] {
        return Array.from(this.fileMap.values()).filter(f => f.hash === hash);
    }

    /**
     * List files matching specific extensions (case-insensitive).
     * @param extensions List of extensions with dot (e.g. [".jpg", ".png"])
     */
    listByExtension(extensions: string[]): FileEntry[] {
        const normalized = extensions.map(e => e.toLowerCase());
        return Array.from(this.fileMap.values()).filter(f => {
             const lower = f.path.toLowerCase();
             return normalized.some(ext => lower.endsWith(ext));
        });
    }

    /**
     * Checks if all resource_ref pointers exist in the archive.
     * Returns list of paths with missing resources.
     */
    validateIntegrity(): string[] {
        const missing: string[] = [];
        for (const entry of this.fileMap.values()) {
            if (entry.resource_ref) {
                const path = `resources/${entry.resource_ref}`;
                if (!this.zip.file(path)) {
                    missing.push(entry.path);
                }
            }
        }
        return missing;
    }
}

// ================== Extension Helpers ==================

/**
 * Extension names supported by MeshSync
 */
export const ExtensionNames = {
{% for ext in extensions %}
  {{ ext.name | upper }}: '{{ ext.name }}',
{% endfor %}
} as const;

/**
 * Supported versions per extension
 */
export const ExtensionVersions: Record<string, string[]> = {
{% for ext in extensions %}
  '{{ ext.name }}': {{ ext.versions | tojson }},
{% endfor %}
};

/**
 * Get a specific version of an extension from the extensions object.
 */
export function getExtensionVersion<T = Record<string, any>>(
  extensions: Record<string, any> | undefined,
  extName: string,
  version: string
): T | undefined {
  if (!extensions) return undefined;
  const ext = extensions[extName];
  if (!ext || typeof ext !== 'object') return undefined;
  return ext[version] as T | undefined;
}

/**
 * Get the latest (highest numbered) version of an extension.
 */
export function getLatestExtension<T = Record<string, any>>(
  extensions: Record<string, any> | undefined,
  extName: string
): { version: string; data: T } | undefined {
  if (!extensions) return undefined;
  const ext = extensions[extName];
  if (!ext || typeof ext !== 'object') return undefined;
  
  const versions = Object.keys(ext)
    .filter(k => k.startsWith('v') && !isNaN(parseInt(k.slice(1))))
    .sort((a, b) => parseInt(b.slice(1)) - parseInt(a.slice(1)));
  
  if (versions.length === 0) return undefined;
  const latest = versions[0];
  return { version: latest, data: ext[latest] as T };
}

/**
 * Get the best matching version of an extension (<= maxVersion).
 */
export function getBestExtension<T = Record<string, any>>(
  extensions: Record<string, any> | undefined,
  extName: string,
  maxVersion?: string
): { version: string; data: T } | undefined {
  if (!maxVersion) return getLatestExtension(extensions, extName);
  if (!extensions) return undefined;
  
  const ext = extensions[extName];
  if (!ext || typeof ext !== 'object') return undefined;
  
  const maxNum = parseInt(maxVersion.replace('v', ''));
  const versions = Object.keys(ext)
    .filter(k => k.startsWith('v') && !isNaN(parseInt(k.slice(1))))
    .filter(k => parseInt(k.slice(1)) <= maxNum)
    .sort((a, b) => parseInt(b.slice(1)) - parseInt(a.slice(1)));
  
  if (versions.length === 0) return undefined;
  const best = versions[0];
  return { version: best, data: ext[best] as T };
}

/**
 * Set an extension version in the extensions object.
 */
export function setExtension(
  extensions: Record<string, any>,
  extName: string,
  version: string,
  data: Record<string, any>
): Record<string, any> {
  if (!extensions[extName]) {
    extensions[extName] = {};
  }
  extensions[extName][version] = data;
  return extensions;
}

// ================== Typed Extension Interfaces ==================

{% for ext in extensions %}
{% for version_name, ext_models in ext.version_models.items() %}
{% for model in ext_models %}
/**
 * {{ ext.name }} {{ version_name }}{% if not model.is_root %} ({{ model.name }}){% endif %} extension data
 */
export interface {{ model.name }} {
{% for field in model.fields %}
  {{ field.name }}?: {% if field.type.is_inline_class -%}
  {{ field.type.base }}
  {%- elif field.type.is_array -%}
    {%- if field.type.item_type.base == "string" -%}
    string[]
    {%- elif field.type.item_type.base == "integer" or field.type.item_type.base == "number" -%}
    number[]
    {%- else -%}
    any[]
    {%- endif -%}
  {%- elif field.type.base == "string" -%}
  string
  {%- elif field.type.base == "integer" or field.type.base == "number" -%}
  number
  {%- elif field.type.base == "boolean" -%}
  boolean
  {%- else -%}
  any
  {%- endif -%};
{% endfor %}
}

{% endfor %}
{% endfor %}
{% endfor %}

// ================== Convenience Accessors ==================

{% for ext in extensions %}
{% for version_name, ext_models in ext.version_models.items() %}
{% for model in ext_models %}
{% if model.is_root %}
{% set func_name = ext.name | replace('meshsync_', '') | title | replace('_', '') %}
export function get{{ func_name }}(extensions: Record<string, any> | undefined): {{ model.name }} | undefined {
  return getBestExtension<{{ model.name }}>(extensions, ExtensionNames.{{ ext.name | upper }}, '{{ version_name }}')?.data;
}

{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}