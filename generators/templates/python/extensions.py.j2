{% for ext in extensions %}
@dataclass
class {{ ext.name | replace('meshsync_', '') | title | replace('_', '') }}V1:
    """Typed accessor for {{ ext.name }} v1 extension data."""
    data: Dict[str, Any]
    
    @classmethod
    def from_extensions(cls, extensions: Dict[str, Any]) -> Optional['{{ ext.name | replace("meshsync_", "") | title | replace("_", "") }}V1']:
        """Extract {{ ext.name }} v1 from extensions dict."""
        v, d = get_extension_version(extensions, "{{ ext.name }}", "v1"), None
        if v is None:
            _, d = get_best_extension(extensions, "{{ ext.name }}", "v1")
        else:
            d = v
        if d is None:
            return None
        return cls(data=d)
    
    def get(self, key: str, default: Any = None) -> Any:
        """Get a field from the extension data."""
        return self.data.get(key, default)

