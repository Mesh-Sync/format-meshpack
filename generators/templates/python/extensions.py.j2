# ----- Convenience Functions -----

def get_geometry(extensions: Dict[str, Any]) -> Optional[GeometryV1]:
    """Get meshsync_geometry extension (v1)."""
    return GeometryV1.from_extensions(extensions)

def get_dependencies(extensions: Dict[str, Any]) -> Optional[DependenciesV1]:
    """Get meshsync_dependencies extension (v1)."""
    return DependenciesV1.from_extensions(extensions)

def get_printability(extensions: Dict[str, Any]) -> Optional[PrintabilityV1]:
    """Get meshsync_printability extension (v1)."""
    return PrintabilityV1.from_extensions(extensions)
