MeshPack Extension Helpers
Version: {{ version }}

Provides utilities for reading and writing versioned MeshSync extensions.
Extensions follow the pattern: { "meshsync_<name>": { "v1": {...}, "v2": {...} } }
"""

from typing import Dict, Any, Optional, TypeVar, Generic, List
