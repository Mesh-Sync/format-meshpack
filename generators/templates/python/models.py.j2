class ValidationFinding(BaseModel):
    severity: str
    code: str
    message: str


class ValidationResult(BaseModel):
    findings: List[ValidationFinding] = Field(default_factory=list)

    @property
    def valid(self) -> bool:
        return not any(finding.severity == "ERROR" for finding in self.findings)

    @property
    def errors(self) -> List[ValidationFinding]:
        return [finding for finding in self.findings if finding.severity == "ERROR"]

    @property
    def warnings(self) -> List[ValidationFinding]:
        return [finding for finding in self.findings if finding.severity == "WARNING"]


def _finding(severity: str, code: str, message: str) -> ValidationFinding:
    return ValidationFinding(severity=severity, code=code, message=message)


def _path_sort_key(path: Any) -> bytes:
    return str(path).encode("utf-8")


def _jcs_key_sort_key(key: Any) -> bytes:
    return str(key).encode("utf-16-be")


def _canonical_json(value: Any) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return _canonical_number(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return "[" + ",".join(_canonical_json(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{" + ",".join(
            json.dumps(str(key), ensure_ascii=False) + ":" + _canonical_json(value[key])
            for key in sorted(value.keys(), key=_jcs_key_sort_key)
        ) + "}"
    raise TypeError(f"Unsupported JSON value for canonicalization: {type(value)!r}")


def _canonical_number(value: float) -> str:
    if value != value:
        raise ValueError("JCS: NaN is not allowed in canonical JSON")
    if value == float("inf") or value == float("-inf"):
        raise ValueError("JCS: Infinity is not allowed in canonical JSON")
    if value == 0.0:
        return "0"

    sign = "-" if value < 0 else ""
    abs_value = abs(value)
    if abs_value.is_integer() and abs_value < 1e21:
        return sign + str(int(abs_value))

    text = repr(abs_value)
    if "e" in text or "E" in text:
        mantissa, exponent = text.lower().split("e")
        exp_offset = int(exponent)
        int_part, _, frac_part = mantissa.partition(".")
        digits = int_part + frac_part
        n = exp_offset + len(int_part)
    else:
        int_part, _, frac_part = text.partition(".")
        digits = int_part + frac_part
        n = len(int_part)

    digits = digits.rstrip("0")
    k = len(digits)
    if k <= n <= 21:
        return sign + digits + "0" * (n - k)
    if 0 < n <= 21:
        return sign + digits[:n] + "." + digits[n:]
    if -6 < n <= 0:
        return sign + "0." + "0" * (-n) + digits
    exponent = n - 1
    if k == 1:
        return sign + digits + "e" + ("+" if exponent >= 0 else "") + str(exponent)
    return sign + digits[0] + "." + digits[1:] + "e" + ("+" if exponent >= 0 else "") + str(exponent)


def _compute_digest(data: bytes, algo: str) -> str:
    if algo == "sha256":
        return hashlib.sha256(data).hexdigest()
    if algo == "sha512":
        return hashlib.sha512(data).hexdigest()
    if algo == "blake3":
        try:
            import blake3  # type: ignore[import-untyped]
        except ImportError as exc:
            raise ValueError("BLAKE3 support requires the blake3 package") from exc
        return blake3.blake3(data).hexdigest()
    raise ValueError(f"Unsupported hash algorithm: {algo}")


def _compute_entries_hash(entries: List[Dict[str, Any]], algo: str) -> str:
    sorted_entries = sorted(entries, key=lambda entry: _path_sort_key(entry.get("path", "")))
    digest = _compute_digest(_canonical_json(sorted_entries).encode("utf-8"), algo)
    return f"{algo}:{digest}"


def _check_format_version(format_version: Any, findings: List[ValidationFinding]) -> None:
    if not isinstance(format_version, str):
        return
    match = SEMVER_PATTERN.match(format_version)
    if not match:
        findings.append(_finding("WARNING", "MAN-011", f"format_version '{format_version}' is not valid semver"))
        return
    major = int(match.group(1))
    if major > SUPPORTED_FORMAT_MAJOR:
        findings.append(_finding("ERROR", "MAN-013", f"Unsupported format_version {format_version}; maximum supported major version is {SUPPORTED_FORMAT_MAJOR}.x.x"))


def _check_readme_layout(archive: zipfile.ZipFile, names_set: set[str], findings: List[ValidationFinding]) -> None:
    if "_README.md" not in names_set:
        findings.append(_finding("WARNING", "LAY-001", "Root _README.md is missing; L2 writers must include a human-readable root description."))
    if any(name.startswith("index/part-") and name.endswith(".json") for name in names_set) and "index/_README.md" not in names_set:
        findings.append(_finding("WARNING", "LAY-002", "index/_README.md is missing; L2 writers must document the sharded index directory."))
    if any(name.startswith("resources/") and name != "resources/_README.md" for name in names_set) and "resources/_README.md" not in names_set:
        findings.append(_finding("WARNING", "LAY-003", "resources/_README.md is missing while embedded resources are present."))
    for readme_path in ("_README.md", "index/_README.md", "resources/_README.md"):
        if readme_path not in names_set:
            continue
        if b"\r" in archive.read(readme_path):
            findings.append(_finding("ERROR", "LAY-004", f"{readme_path} must use LF line endings, not CRLF/CR."))


def _check_entry_path(path: str, shard_path: str, findings: List[ValidationFinding]) -> None:
    if len(path) > 1024:
        findings.append(_finding("ERROR", "ENT-001", f"Path exceeds 1024 chars in {shard_path}: {path[:80]}..."))
    if re.search(r"(^|/)\.\.(/|$)", path):
        findings.append(_finding("ERROR", "ENT-002", f"Path traversal detected in {shard_path}: {path}"))
    if path.startswith("/"):
        findings.append(_finding("ERROR", "ENT-003", f"Absolute path in {shard_path}: {path}"))
    if len(path) >= 2 and path[0].isalpha() and path[1] == ":":
        findings.append(_finding("ERROR", "ENT-004", f"Drive letter path in {shard_path}: {path}"))
    if path.startswith("\\\\"):
        findings.append(_finding("ERROR", "ENT-005", f"UNC path in {shard_path}: {path}"))


def _is_safe_resource_ref(resource_ref: str) -> bool:
    return bool(RESOURCE_REF_PATTERN.match(resource_ref)) and "/" not in resource_ref and "\\" not in resource_ref


def _check_resource_ref(
    resource_ref: Any,
    field_name: str,
    shard_path: str,
    entry_path: str,
    findings: List[ValidationFinding],
) -> None:
    if resource_ref is None or resource_ref == "":
        return
    if not isinstance(resource_ref, str):
        findings.append(_finding("ERROR", "RES-004", f"{field_name} for {shard_path}:{entry_path} must be a string"))
        return
    if ":" in resource_ref:
        findings.append(_finding("WARNING", "RES-003", f"{field_name} contains ':' in {shard_path}:{entry_path}"))
    if not _is_safe_resource_ref(resource_ref):
        findings.append(_finding("ERROR", "RES-004", f"Unsafe or non-canonical {field_name} in {shard_path}:{entry_path}: {resource_ref}"))


def _verify_signature_entries(signatures: List[Dict[str, Any]], pack_hash: str) -> List[ValidationFinding]:
    findings: List[ValidationFinding] = []
    try:
        import base64
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
        from cryptography.hazmat.primitives.asymmetric.padding import MGF1, PSS
        from cryptography.hazmat.primitives.hashes import SHA256
        from cryptography.hazmat.primitives.serialization import load_der_public_key
    except ImportError:
        return [_finding("WARNING", "SIG-001", "Signature verification requires the cryptography package")]

    signed_data = pack_hash.encode("utf-8")
    for index, signature_entry in enumerate(signatures):
        signer = signature_entry.get("signer_id", f"signature[{index}]")
        alg = signature_entry.get("alg", "")
        public_key = signature_entry.get("public_key", "")
        signature = signature_entry.get("signature", "")
        if not alg or not public_key or not signature:
            findings.append(_finding("ERROR", "SIG-002", f"{signer}: missing required field (alg/public_key/signature)"))
            continue

        try:
            public_key_bytes = base64.b64decode(public_key)
            signature_bytes = base64.b64decode(signature)
        except Exception as exc:
            findings.append(_finding("ERROR", "SIG-003", f"{signer}: invalid base64 encoding — {exc}"))
            continue

        if alg == "ed25519":
            try:
                key_bytes = public_key_bytes[-32:] if len(public_key_bytes) != 32 else public_key_bytes
                Ed25519PublicKey.from_public_bytes(key_bytes).verify(signature_bytes, signed_data)
                findings.append(_finding("INFO", "SIG-010", f"{signer}: Ed25519 signature verified successfully"))
            except Exception as exc:
                findings.append(_finding("ERROR", "SIG-004", f"{signer}: Ed25519 signature verification failed — {exc}"))
        elif alg == "rsa-pss-sha256":
            try:
                key = load_der_public_key(public_key_bytes)
                key.verify(signature_bytes, signed_data, PSS(mgf=MGF1(SHA256()), salt_length=PSS.MAX_LENGTH), SHA256())
                findings.append(_finding("INFO", "SIG-010", f"{signer}: RSA-PSS-SHA256 signature verified successfully"))
            except Exception as exc:
                findings.append(_finding("ERROR", "SIG-004", f"{signer}: RSA-PSS-SHA256 signature verification failed — {exc}"))
        else:
            findings.append(_finding("INFO", "SIG-005", f"{signer}: unsupported algorithm '{alg}' — skipped"))

    return findings


def _check_sidecar(
    file_path: str,
    manifest: Dict[str, Any],
    findings: List[ValidationFinding],
    sidecar_path: Optional[str] = None,
    verify_signatures: bool = False,
) -> None:
    if sidecar_path is None:
        auto_path = file_path + ".integrity"
        if os.path.exists(auto_path):
            sidecar_path = auto_path

    if sidecar_path is None:
        findings.append(_finding("INFO", "SDC-001", "No .meshpack.integrity sidecar found; skipping pack-level hash verification."))
        return

    try:
        with open(sidecar_path, "r", encoding="utf-8") as sidecar_file:
            sidecar_data = json.load(sidecar_file)
    except (json.JSONDecodeError, OSError) as exc:
        findings.append(_finding("ERROR", "SDC-002", f"Failed to load sidecar: {exc}"))
        return

    try:
        Sidecar(**sidecar_data)
    except ValidationError as exc:
        findings.append(_finding("ERROR", "SCH-001", f"Sidecar schema validation failed: {exc}"))

    pack_name = sidecar_data.get("pack_name")
    if pack_name and pack_name != os.path.basename(file_path):
        findings.append(_finding("ERROR", "SDC-006", f"Sidecar pack_name mismatch: sidecar expects {pack_name}, archive is {os.path.basename(file_path)}"))

    pack_size_bytes = sidecar_data.get("pack_size_bytes")
    if isinstance(pack_size_bytes, int):
        actual_size = os.path.getsize(file_path)
        if pack_size_bytes != actual_size:
            findings.append(_finding("ERROR", "SDC-007", f"Sidecar pack_size_bytes mismatch: sidecar expects {pack_size_bytes}, archive is {actual_size}"))

    sidecar_algo = sidecar_data.get("hash_algo", "")
    sidecar_hash = sidecar_data.get("pack_hash", "")
    manifest_algo = manifest.get("hash_algo", "")
    if sidecar_algo and manifest_algo and sidecar_algo != manifest_algo:
        findings.append(_finding("ERROR", "SDC-008", f"Sidecar hash_algo mismatch: sidecar uses {sidecar_algo}, manifest uses {manifest_algo}"))
    if not sidecar_algo or not sidecar_hash:
        findings.append(_finding("WARNING", "SDC-003", "Sidecar missing hash_algo or pack_hash"))
        return

    try:
        with open(file_path, "rb") as archive_file:
            digest = _compute_digest(archive_file.read(), sidecar_algo)
    except (OSError, ValueError) as exc:
        findings.append(_finding("WARNING", "SDC-004", str(exc)))
        return

    actual = f"{sidecar_algo}:{digest}" if ":" in sidecar_hash else digest
    if actual != sidecar_hash:
        findings.append(_finding("ERROR", "SDC-005", f"Pack hash mismatch: sidecar expects {sidecar_hash}, computed {actual}"))
    else:
        findings.append(_finding("INFO", "SDC-010", "Pack hash verified successfully via sidecar."))

    signatures = sidecar_data.get("signatures")
    if isinstance(signatures, list) and signatures and verify_signatures:
        findings.extend(_verify_signature_entries(signatures, sidecar_hash))
    elif isinstance(signatures, list) and signatures:
        findings.append(_finding("INFO", "SDC-011", f"Sidecar contains {len(signatures)} signature(s). Enable signature verification to check them."))


def validate_meshpack(
    file_path: str,
    max_size: int = MAX_DECOMPRESSED_SIZE,
    max_ratio: int = MAX_COMPRESSION_RATIO,
    sidecar_path: Optional[str] = None,
    verify_signatures: bool = False,
) -> ValidationResult:
    findings: List[ValidationFinding] = []

    try:
        archive = zipfile.ZipFile(file_path, "r")
    except (FileNotFoundError, zipfile.BadZipFile) as exc:
        return ValidationResult(findings=[_finding("ERROR", "ARC-001", f"Cannot open archive: {exc}")])

    with archive:
        names = archive.namelist()
        names_set = set(names)
        if names and names[0] != "manifest.json":
            findings.append(_finding("WARNING", "ZIP-001", f"manifest.json should be the first ZIP entry (found '{names[0]}' first)"))
        _check_readme_layout(archive, names_set, findings)

        total_decompressed = 0
        for info in archive.infolist():
            total_decompressed += info.file_size
            if info.compress_type not in ALLOWED_COMPRESSION:
                findings.append(_finding("ERROR", "ZIP-003", f"Entry '{info.filename}' uses unsupported compression method {info.compress_type}"))
            if info.compress_size > 0 and info.file_size / info.compress_size > max_ratio:
                findings.append(_finding("ERROR", "ZIP-004", f"Entry '{info.filename}' exceeds compression ratio limit {max_ratio}:1"))
        if total_decompressed > max_size:
            findings.append(_finding("ERROR", "ZIP-005", f"Total decompressed size exceeds limit of {max_size} bytes"))

        if "manifest.json" not in names_set:
            findings.append(_finding("ERROR", "MAN-001", "manifest.json not found in archive"))
            return ValidationResult(findings=findings)

        try:
            with archive.open("manifest.json") as manifest_file:
                manifest = json.load(manifest_file)
        except (json.JSONDecodeError, KeyError) as exc:
            findings.append(_finding("ERROR", "MAN-002", f"Failed to parse manifest.json: {exc}"))
            return ValidationResult(findings=findings)

        required = ["format_version", "created_at", "creator_info", "platform_info", "index_summary", "hash_algo", "shard_list"]
        for field_name in required:
            if field_name not in manifest:
                findings.append(_finding("ERROR", "MAN-010", f"Missing required field: {field_name}"))
        _check_format_version(manifest.get("format_version"), findings)

        algo = manifest.get("hash_algo", "sha256")
        if algo not in {"sha256", "sha512", "blake3"}:
            findings.append(_finding("ERROR", "MAN-012", f"Unsupported hash_algo: '{algo}'"))
        shard_list = manifest.get("shard_list")
        if not isinstance(shard_list, list) or not shard_list:
            findings.append(_finding("ERROR", "MAN-014", "shard_list must be a non-empty array"))
            shard_list = []

        summary = manifest.get("index_summary")
        if isinstance(summary, dict):
            for field_name in ("total_files", "total_shards", "total_size_bytes"):
                if field_name not in summary:
                    findings.append(_finding("ERROR", "MAN-015", f"index_summary missing required field: {field_name}"))

        for shard_meta in shard_list:
            shard_id = shard_meta.get("id", "")
            shard_path = f"index/{shard_id}.json"
            if not re.match(r"^part-\d{5}$", shard_id):
                findings.append(_finding("WARNING", "SHD-001", f"shard_id '{shard_id}' does not match ^part-\\d{{5}}$"))
            if shard_path not in names_set:
                findings.append(_finding("ERROR", "SHD-002", f"Shard file missing in archive: {shard_path}"))
                continue
            try:
                with archive.open(shard_path) as shard_file:
                    shard = json.load(shard_file)
            except (json.JSONDecodeError, KeyError) as exc:
                findings.append(_finding("ERROR", "SHD-003", f"Failed to parse {shard_path}: {exc}"))
                continue

            entries = shard.get("entries", [])
            paths = [entry.get("path", "") for entry in entries]
            if paths != sorted(paths, key=_path_sort_key):
                findings.append(_finding("WARNING", "SHD-004", f"Entries not sorted by UTF-8 path order in {shard_path}"))
            expected_count = shard_meta.get("entries_count", shard.get("entries_count"))
            if expected_count is not None and expected_count != len(entries):
                findings.append(_finding("ERROR", "SHD-005", f"entries_count mismatch in {shard_path}: expected {expected_count}, got {len(entries)}"))
            expected_hash = shard_meta.get("entries_hash") or shard.get("entries_hash")
            if expected_hash:
                try:
                    actual_hash = _compute_entries_hash(entries, algo)
                    if actual_hash != expected_hash:
                        findings.append(_finding("ERROR", "SHD-007", f"entries_hash mismatch in {shard_path}: expected {expected_hash}, got {actual_hash}"))
                except ValueError as exc:
                    findings.append(_finding("WARNING", "SHD-006", f"Hash algo error in {shard_path}: {exc}"))

            for entry in entries:
                entry_path = entry.get("path", "")
                _check_entry_path(entry_path, shard_path, findings)
                entry_hash = entry.get("hash", "")
                if entry_hash and not HASH_PATTERN.match(entry_hash):
                    findings.append(_finding("WARNING", "HSH-001", f"Hash format invalid for {entry_path} in {shard_path}"))
                resource_ref = entry.get("resource_ref")
                if resource_ref and not entry.get("resource_hash"):
                    findings.append(_finding("WARNING", "RES-001", f"{shard_path}:{entry_path} has resource_ref but missing resource_hash"))
                _check_resource_ref(resource_ref, "resource_ref", shard_path, entry_path, findings)
                if resource_ref and f"resources/{resource_ref}" not in names_set:
                    findings.append(_finding("ERROR", "RES-002", f"Missing embedded resource: resources/{resource_ref}"))
                preview_ref = entry.get("preview_ref")
                _check_resource_ref(preview_ref, "preview_ref", shard_path, entry_path, findings)
                if preview_ref and f"resources/{preview_ref}" not in names_set:
                    findings.append(_finding("ERROR", "RES-002", f"Missing embedded resource: resources/{preview_ref}"))

        _check_sidecar(file_path, manifest, findings, sidecar_path, verify_signatures)

    return ValidationResult(findings=findings)

class MeshPackReader:
    def __init__(self, file_path: str):
        self.file_path = file_path
        self._zip = zipfile.ZipFile(file_path, "r")
        self._manifest: Optional[Manifest] = None
        self._files: Dict[str, FileEntry] = {}
        self._loaded = False

    def close(self) -> None:
        self._zip.close()

    def load(self) -> None:
        if self._loaded:
            return

        with self._zip.open("manifest.json") as manifest_file:
            self._manifest = Manifest(**json.load(manifest_file))

        for shard_ref in self._manifest.shard_list:
            shard_path = f"index/{shard_ref.id}.json"
            with self._zip.open(shard_path) as shard_file:
                shard = Shard(**json.load(shard_file))
                for entry in shard.entries:
                    self._files[entry.path] = entry

        self._loaded = True

    @property
    def manifest(self) -> Manifest:
        self.load()
        if self._manifest is None:
            raise ValueError("manifest.json was not loaded")
        return self._manifest

    def get_file_entry(self, path: str) -> Optional[FileEntry]:
        self.load()
        return self._files.get(path)

    def list_model_entries(self) -> List[FileEntry]:
        self.load()
        model_exts = {".stl", ".obj", ".3mf", ".step", ".stp", ".ply", ".off"}
        return [entry for entry in self._files.values() if os.path.splitext(entry.path)[1].lower() in model_exts]

    def list_by_extension(self, extensions: List[str]) -> List[FileEntry]:
        self.load()
        normalized = {extension.lower() for extension in extensions}
        return [entry for entry in self._files.values() if os.path.splitext(entry.path)[1].lower() in normalized]

    def get_files_by_hash(self, file_hash: str) -> List[FileEntry]:
        self.load()
        return [entry for entry in self._files.values() if entry.hash == file_hash]

    def read_resource(self, file_entry: FileEntry) -> Optional[bytes]:
        if not file_entry.resource_ref:
            return None
        if not _is_safe_resource_ref(file_entry.resource_ref):
            return None
        try:
            with self._zip.open(f"resources/{file_entry.resource_ref}") as resource_file:
                return resource_file.read()
        except KeyError:
            return None

    def validate_integrity(self) -> Dict[str, List[str]]:
        self.load()
        missing_resources = []
        names = set(self._zip.namelist())
        for entry in self._files.values():
            if entry.resource_ref and not _is_safe_resource_ref(entry.resource_ref):
                missing_resources.append(entry.path)
                continue
            if entry.resource_ref and f"resources/{entry.resource_ref}" not in names:
                missing_resources.append(entry.path)
        return {"missing_resources": missing_resources}
