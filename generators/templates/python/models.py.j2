from __future__ import annotations

from datetime import datetime
from enum import Enum
from typing import Any, Dict, List, Optional
import hashlib
import json
import os
import re
import zipfile

from pydantic import BaseModel, Field, ValidationError


__version__ = "{{ version }}"

HASH_PATTERN = re.compile(r"^(sha256:[a-f0-9]{64}|sha512:[a-f0-9]{128}|blake3:[a-f0-9]{64})$")
RESOURCE_REF_PATTERN = re.compile(r"^([a-f0-9]{64}|[a-f0-9]{128})\.[A-Za-z0-9][A-Za-z0-9._-]{0,31}$")
ALLOWED_COMPRESSION = {zipfile.ZIP_DEFLATED, zipfile.ZIP_STORED}
MAX_DECOMPRESSED_SIZE = 10 * 1024**3
MAX_COMPRESSION_RATIO = 100
SUPPORTED_FORMAT_MAJOR = int("{{ version }}".split(".")[0])
SEMVER_PATTERN = re.compile(r"^(\d+)\.(\d+)\.(\d+)$")


