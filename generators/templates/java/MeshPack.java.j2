public final class MeshPack {
  public static final String VERSION = "{{ version }}";
  private static final int SUPPORTED_FORMAT_MAJOR = {{ format_major }};
  private static final String RESOURCE_REF_PATTERN = "^([a-f0-9]{64}|[a-f0-9]{128})\\.[A-Za-z0-9][A-Za-z0-9._-]{0,31}$";
  private static final String SEMVER_PATTERN = "^\\d+\\.\\d+\\.\\d+$";
  private static final ObjectMapper MAPPER = new ObjectMapper()
      .registerModule(new JavaTimeModule())
      .configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);

  private MeshPack() {}

