  @JsonIgnoreProperties(ignoreUnknown = true)
  public record MeshPackDocument(Manifest manifest, List<Shard> shards, List<FileEntry> entries) {}

  public record ValidationFinding(String severity, String code, String message) {}

  public record ValidationResult(List<ValidationFinding> findings) {
    public boolean valid() {
      return findings.stream().noneMatch(finding -> "ERROR".equals(finding.severity()));
    }

    public List<ValidationFinding> errors() {
      return findings.stream().filter(finding -> "ERROR".equals(finding.severity())).toList();
    }

    public List<ValidationFinding> warnings() {
      return findings.stream().filter(finding -> "WARNING".equals(finding.severity())).toList();
    }
  }

  public static ValidationResult validate(Path path) {
    return validate(path, false);
  }

  public static ValidationResult validate(Path path, boolean verifySignatures) {
    List<ValidationFinding> findings = new ArrayList<>();
    try (ZipFile archive = new ZipFile(path.toFile())) {
      List<? extends ZipEntry> entries = archive.stream().toList();
      Set<String> names = archive.stream().map(ZipEntry::getName).collect(java.util.stream.Collectors.toSet());
      if (!entries.isEmpty() && !"manifest.json".equals(entries.get(0).getName())) {
        findings.add(finding("WARNING", "ZIP-001", "manifest.json should be the first ZIP entry (found '" + entries.get(0).getName() + "' first)"));
      }
      validateReadmeLayout(archive, names, findings);

      long totalDecompressed = 0;
      for (ZipEntry entry : entries) {
        totalDecompressed += entry.getSize() < 0 ? 0 : entry.getSize();
        if (entry.getMethod() != ZipEntry.STORED && entry.getMethod() != ZipEntry.DEFLATED) {
          findings.add(finding("ERROR", "ZIP-003", "Entry '" + entry.getName() + "' uses unsupported compression method " + entry.getMethod()));
        }
        if (entry.getCompressedSize() > 0 && entry.getSize() / entry.getCompressedSize() > 100) {
          findings.add(finding("ERROR", "ZIP-004", "Entry '" + entry.getName() + "' exceeds compression ratio limit 100:1"));
        }
      }
      if (totalDecompressed > 10L * 1024L * 1024L * 1024L) {
        findings.add(finding("ERROR", "ZIP-005", "Total decompressed size exceeds limit of 10737418240 bytes"));
      }

      if (!names.contains("manifest.json")) {
        findings.add(finding("ERROR", "MAN-001", "manifest.json not found in archive"));
        return new ValidationResult(findings);
      }

      Manifest manifest;
      try {
        manifest = MAPPER.readValue(readText(archive, "manifest.json"), Manifest.class);
      } catch (IOException exception) {
        findings.add(finding("ERROR", "MAN-002", "Failed to parse manifest.json: " + exception.getMessage()));
        return new ValidationResult(findings);
      }

      validateFormatVersion(manifest.format_version(), findings);

      if (!List.of("sha256", "sha512", "blake3").contains(manifest.hash_algo())) {
        findings.add(finding("ERROR", "MAN-012", "Unsupported hash_algo: '" + manifest.hash_algo() + "'"));
      }

      if (manifest.shard_list() == null || manifest.shard_list().isEmpty()) {
        findings.add(finding("ERROR", "MAN-014", "shard_list must be a non-empty array"));
        return new ValidationResult(findings);
      }

      for (ShardReference shardRef : manifest.shard_list()) {
        String shardPath = "index/" + shardRef.id() + ".json";
        if (!shardRef.id().matches("^part-\\d{5}$")) {
          findings.add(finding("WARNING", "SHD-001", "shard_id '" + shardRef.id() + "' does not match ^part-\\d{5}$"));
        }
        if (!names.contains(shardPath)) {
          findings.add(finding("ERROR", "SHD-002", "Shard file missing in archive: " + shardPath));
          continue;
        }

        String shardJson;
        Shard shard;
        try {
          shardJson = readText(archive, shardPath);
          shard = MAPPER.readValue(shardJson, Shard.class);
        } catch (IOException exception) {
          findings.add(finding("ERROR", "SHD-003", "Failed to parse " + shardPath + ": " + exception.getMessage()));
          continue;
        }

        List<FileEntry> shardEntries = shard.entries() == null ? List.of() : shard.entries();
        List<String> paths = shardEntries.stream().map(FileEntry::path).toList();
        List<String> sortedPaths = paths.stream().sorted(MeshPack::compareUtf8).toList();
        if (!paths.equals(sortedPaths)) {
          findings.add(finding("WARNING", "SHD-004", "Entries not sorted by UTF-8 path order in " + shardPath));
        }
        if (!Long.valueOf(shardEntries.size()).equals(shardRef.entries_count())) {
          findings.add(finding("ERROR", "SHD-005", "entries_count mismatch in " + shardPath + ": expected " + shardRef.entries_count() + ", got " + shardEntries.size()));
        }
        try {
          String actualHash = computeEntriesHash(shardJson, manifest.hash_algo());
          if (!actualHash.equals(shardRef.entries_hash())) {
            findings.add(finding("ERROR", "SHD-007", "entries_hash mismatch in " + shardPath + ": expected " + shardRef.entries_hash() + ", got " + actualHash));
          }
        } catch (IllegalArgumentException exception) {
          findings.add(finding("WARNING", "SHD-006", "Hash algo error in " + shardPath + ": " + exception.getMessage()));
        }

        for (FileEntry entry : shardEntries) {
          validateEntryPath(entry.path(), shardPath, findings);
          if (entry.hash() != null && !isHashValue(entry.hash())) {
            findings.add(finding("WARNING", "HSH-001", "Hash format invalid for " + entry.path() + " in " + shardPath));
          }
          if (entry.resource_ref() != null && entry.resource_hash() == null) {
            findings.add(finding("WARNING", "RES-001", shardPath + ":" + entry.path() + " has resource_ref but missing resource_hash"));
          }
          validateResourceRef(entry.resource_ref(), "resource_ref", shardPath, entry.path(), findings);
          if (entry.resource_ref() != null && !names.contains("resources/" + entry.resource_ref())) {
            findings.add(finding("ERROR", "RES-002", "Missing embedded resource: resources/" + entry.resource_ref()));
          }
          validateResourceRef(entry.preview_ref(), "preview_ref", shardPath, entry.path(), findings);
          if (entry.preview_ref() != null && !names.contains("resources/" + entry.preview_ref())) {
            findings.add(finding("ERROR", "RES-002", "Missing embedded resource: resources/" + entry.preview_ref()));
          }
        }
      }
      verifySidecar(path, manifest, verifySignatures, findings);
    } catch (IOException exception) {
      findings.add(finding("ERROR", "ARC-001", "Cannot open archive: " + exception.getMessage()));
    }

    return new ValidationResult(findings);
  }

  private static ValidationFinding finding(String severity, String code, String message) {
    return new ValidationFinding(severity, code, message);
  }

  private static void validateFormatVersion(String formatVersion, List<ValidationFinding> findings) {
    if (formatVersion == null || !formatVersion.matches(SEMVER_PATTERN)) {
      findings.add(finding("WARNING", "MAN-011", "format_version '" + formatVersion + "' is not valid semver"));
      return;
    }
    int major = Integer.parseInt(formatVersion.substring(0, formatVersion.indexOf('.')));
    if (major > SUPPORTED_FORMAT_MAJOR) {
      findings.add(finding("ERROR", "MAN-013", "Unsupported format_version " + formatVersion + "; maximum supported major version is " + SUPPORTED_FORMAT_MAJOR + ".x.x"));
    }
  }

  private static void validateReadmeLayout(ZipFile archive, Set<String> names, List<ValidationFinding> findings) throws IOException {
    if (!names.contains("_README.md")) {
      findings.add(finding("WARNING", "LAY-001", "Root _README.md is missing; L2 writers must include a human-readable root description."));
    }
    if (names.stream().anyMatch(name -> name.startsWith("index/part-") && name.endsWith(".json")) && !names.contains("index/_README.md")) {
      findings.add(finding("WARNING", "LAY-002", "index/_README.md is missing; L2 writers must document the sharded index directory."));
    }
    if (names.stream().anyMatch(name -> name.startsWith("resources/") && !"resources/_README.md".equals(name)) && !names.contains("resources/_README.md")) {
      findings.add(finding("WARNING", "LAY-003", "resources/_README.md is missing while embedded resources are present."));
    }
    for (String readmePath : List.of("_README.md", "index/_README.md", "resources/_README.md")) {
      ZipEntry entry = archive.getEntry(readmePath);
      if (entry == null) {
        continue;
      }
      byte[] data = readBytes(archive, entry);
      for (byte item : data) {
        if (item == '\r') {
          findings.add(finding("ERROR", "LAY-004", readmePath + " must use LF line endings, not CRLF/CR."));
          break;
        }
      }
    }
  }

  private static void validateEntryPath(String path, String shardPath, List<ValidationFinding> findings) {
    if (path.length() > 1024) {
      findings.add(finding("ERROR", "ENT-001", "Path exceeds 1024 chars in " + shardPath + ": " + path.substring(0, Math.min(path.length(), 80)) + "..."));
    }
    if (List.of(path.split("/")).contains("..")) {
      findings.add(finding("ERROR", "ENT-002", "Path traversal detected in " + shardPath + ": " + path));
    }
    if (path.startsWith("/")) {
      findings.add(finding("ERROR", "ENT-003", "Absolute path in " + shardPath + ": " + path));
    }
    if (path.length() >= 2 && Character.isLetter(path.charAt(0)) && path.charAt(1) == ':') {
      findings.add(finding("ERROR", "ENT-004", "Drive letter path in " + shardPath + ": " + path));
    }
    if (path.startsWith("\\\\")) {
      findings.add(finding("ERROR", "ENT-005", "UNC path in " + shardPath + ": " + path));
    }
  }

  private static boolean isHashValue(String value) {
    return value.matches("^(sha256:[a-f0-9]{64}|sha512:[a-f0-9]{128}|blake3:[a-f0-9]{64})$");
  }

  private static boolean isSafeResourceRef(String value) {
    return value != null && value.matches(RESOURCE_REF_PATTERN) && !value.contains("/") && !value.contains("\\") && !value.contains(":");
  }

  private static void validateResourceRef(String resourceRef, String fieldName, String shardPath, String entryPath, List<ValidationFinding> findings) {
    if (resourceRef == null || resourceRef.isBlank()) {
      return;
    }
    if (resourceRef.contains(":")) {
      findings.add(finding("WARNING", "RES-003", fieldName + " contains ':' in " + shardPath + ":" + entryPath));
    }
    if (!isSafeResourceRef(resourceRef)) {
      findings.add(finding("ERROR", "RES-004", "Unsafe or non-canonical " + fieldName + " in " + shardPath + ":" + entryPath + ": " + resourceRef));
    }
  }

  private static void verifySidecar(Path path, Manifest manifest, boolean verifySignatures, List<ValidationFinding> findings) {
    Path sidecarPath = Path.of(path.toString() + ".integrity");
    if (!Files.exists(sidecarPath)) {
      findings.add(finding("INFO", "SDC-001", "No .meshpack.integrity sidecar found; skipping pack-level hash verification."));
      return;
    }

    Sidecar sidecar;
    try {
      sidecar = MAPPER.readValue(Files.readString(sidecarPath), Sidecar.class);
    } catch (IOException exception) {
      findings.add(finding("ERROR", "SDC-002", "Failed to load sidecar: " + exception.getMessage()));
      return;
    }

    Path fileName = path.getFileName();
    if (fileName != null && sidecar.pack_name() != null && !sidecar.pack_name().equals(fileName.toString())) {
      findings.add(finding("ERROR", "SDC-006", "Sidecar pack_name mismatch: sidecar expects " + sidecar.pack_name() + ", archive is " + fileName));
    }

    try {
      long actualSize = Files.size(path);
      if (sidecar.pack_size_bytes() != null && sidecar.pack_size_bytes() != actualSize) {
        findings.add(finding("ERROR", "SDC-007", "Sidecar pack_size_bytes mismatch: sidecar expects " + sidecar.pack_size_bytes() + ", archive is " + actualSize));
      }
    } catch (IOException exception) {
      findings.add(finding("WARNING", "SDC-004", "Failed to read archive metadata: " + exception.getMessage()));
    }

    if (sidecar.hash_algo() != null && manifest.hash_algo() != null && !sidecar.hash_algo().equals(manifest.hash_algo())) {
      findings.add(finding("ERROR", "SDC-008", "Sidecar hash_algo mismatch: sidecar uses " + sidecar.hash_algo() + ", manifest uses " + manifest.hash_algo()));
    }
    if (sidecar.hash_algo() == null || sidecar.pack_hash() == null) {
      findings.add(finding("WARNING", "SDC-003", "Sidecar missing hash_algo or pack_hash"));
      return;
    }

    try {
      String digest = HexFormat.of().formatHex(digest(Files.readAllBytes(path), sidecar.hash_algo()));
      String actual = sidecar.pack_hash().contains(":") ? sidecar.hash_algo() + ":" + digest : digest;
      if (!actual.equals(sidecar.pack_hash())) {
        findings.add(finding("ERROR", "SDC-005", "Pack hash mismatch: sidecar expects " + sidecar.pack_hash() + ", computed " + actual));
      } else {
        findings.add(finding("INFO", "SDC-010", "Pack hash verified successfully via sidecar."));
      }
    } catch (IOException | IllegalArgumentException exception) {
      findings.add(finding("WARNING", "SDC-004", exception.getMessage()));
      return;
    }

    if (sidecar.signatures() != null && !sidecar.signatures().isEmpty() && verifySignatures) {
      findings.addAll(verifySignatureEntries(sidecar.signatures(), sidecar.pack_hash()));
    } else if (sidecar.signatures() != null && !sidecar.signatures().isEmpty()) {
      findings.add(finding("INFO", "SDC-011", "Sidecar contains " + sidecar.signatures().size() + " signature(s). Enable signature verification to check them."));
    }
  }

  private static List<ValidationFinding> verifySignatureEntries(List<SignatureEntry> signatures, String packHash) {
    List<ValidationFinding> findings = new ArrayList<>();
    byte[] signedData = packHash.getBytes(StandardCharsets.UTF_8);
    for (int index = 0; index < signatures.size(); index++) {
      SignatureEntry signatureEntry = signatures.get(index);
      String signer = signatureEntry.signer_id() == null || signatureEntry.signer_id().isBlank() ? "signature[" + index + "]" : signatureEntry.signer_id();
      if (signatureEntry.alg() == null || signatureEntry.public_key() == null || signatureEntry.signature() == null) {
        findings.add(finding("ERROR", "SIG-002", signer + ": missing required field (alg/public_key/signature)"));
        continue;
      }

      byte[] publicKeyBytes;
      byte[] signatureBytes;
      try {
        publicKeyBytes = Base64.getDecoder().decode(signatureEntry.public_key());
        signatureBytes = Base64.getDecoder().decode(signatureEntry.signature());
      } catch (IllegalArgumentException exception) {
        findings.add(finding("ERROR", "SIG-003", signer + ": invalid base64 encoding - " + exception.getMessage()));
        continue;
      }

      try {
        if ("ed25519".equals(signatureEntry.alg())) {
          Signature verifier = Signature.getInstance("Ed25519");
          verifier.initVerify(ed25519PublicKey(publicKeyBytes));
          verifier.update(signedData);
          if (verifier.verify(signatureBytes)) {
            findings.add(finding("INFO", "SIG-010", signer + ": Ed25519 signature verified successfully"));
          } else {
            findings.add(finding("ERROR", "SIG-004", signer + ": Ed25519 signature verification failed"));
          }
        } else if ("rsa-pss-sha256".equals(signatureEntry.alg())) {
          PublicKey publicKey = KeyFactory.getInstance("RSA").generatePublic(new X509EncodedKeySpec(publicKeyBytes));
          Signature verifier = Signature.getInstance("RSASSA-PSS");
          int saltLength = 32;
          if (publicKey instanceof RSAPublicKey rsaPublicKey) {
            saltLength = Math.max(0, ((rsaPublicKey.getModulus().bitLength() + 7) / 8) - 32 - 2);
          }
          verifier.setParameter(new PSSParameterSpec("SHA-256", "MGF1", MGF1ParameterSpec.SHA256, saltLength, 1));
          verifier.initVerify(publicKey);
          verifier.update(signedData);
          if (verifier.verify(signatureBytes)) {
            findings.add(finding("INFO", "SIG-010", signer + ": RSA-PSS-SHA256 signature verified successfully"));
          } else {
            findings.add(finding("ERROR", "SIG-004", signer + ": RSA-PSS-SHA256 signature verification failed"));
          }
        } else {
          findings.add(finding("INFO", "SIG-005", signer + ": unsupported algorithm '" + signatureEntry.alg() + "' - skipped"));
        }
      } catch (Exception exception) {
        findings.add(finding("ERROR", "SIG-004", signer + ": " + signatureEntry.alg() + " signature verification failed - " + exception.getMessage()));
      }
    }
    return findings;
  }

  private static PublicKey ed25519PublicKey(byte[] publicKeyBytes) throws Exception {
    byte[] spkiBytes = publicKeyBytes;
    if (publicKeyBytes.length == 32) {
      byte[] prefix = HexFormat.of().parseHex("302a300506032b6570032100");
      spkiBytes = new byte[prefix.length + publicKeyBytes.length];
      System.arraycopy(prefix, 0, spkiBytes, 0, prefix.length);
      System.arraycopy(publicKeyBytes, 0, spkiBytes, prefix.length, publicKeyBytes.length);
    } else if (publicKeyBytes.length > 32 && publicKeyBytes.length != 44) {
      byte[] prefix = HexFormat.of().parseHex("302a300506032b6570032100");
      byte[] rawKey = Arrays.copyOfRange(publicKeyBytes, publicKeyBytes.length - 32, publicKeyBytes.length);
      spkiBytes = new byte[prefix.length + rawKey.length];
      System.arraycopy(prefix, 0, spkiBytes, 0, prefix.length);
      System.arraycopy(rawKey, 0, spkiBytes, prefix.length, rawKey.length);
    }
    return KeyFactory.getInstance("Ed25519").generatePublic(new X509EncodedKeySpec(spkiBytes));
  }

  private static String computeEntriesHash(String shardJson, String algo) {
    try {
      JsonNode entries = MAPPER.readTree(shardJson).get("entries");
      List<JsonNode> sortedEntries = new ArrayList<>();
      entries.forEach(sortedEntries::add);
      sortedEntries.sort(Comparator.comparing(node -> node.path("path").asText(""), MeshPack::compareUtf8));
      String canonical = canonicalJson(MAPPER.valueToTree(sortedEntries));
      byte[] digest = digest(canonical.getBytes(StandardCharsets.UTF_8), algo);
      return algo + ":" + HexFormat.of().formatHex(digest);
    } catch (IOException exception) {
      throw new IllegalArgumentException(exception.getMessage(), exception);
    }
  }

  private static byte[] digest(byte[] bytes, String algo) {
    try {
      return switch (algo) {
        case "sha256" -> MessageDigest.getInstance("SHA-256").digest(bytes);
        case "sha512" -> MessageDigest.getInstance("SHA-512").digest(bytes);
        case "blake3" -> blake3(bytes);
        default -> throw new IllegalArgumentException("Unsupported hash algorithm: " + algo);
      };
    } catch (NoSuchAlgorithmException exception) {
      throw new IllegalArgumentException(exception.getMessage(), exception);
    }
  }

  private static byte[] blake3(byte[] bytes) {
    Blake3Digest digest = new Blake3Digest(256);
    digest.update(bytes, 0, bytes.length);
    byte[] output = new byte[digest.getDigestSize()];
    digest.doFinal(output, 0);
    return output;
  }

  private static String canonicalJson(JsonNode node) {
    if (node == null || node.isNull()) {
      return "null";
    }
    if (node.isBoolean() || node.isNumber()) {
      return node.asText();
    }
    if (node.isTextual()) {
      try {
        return MAPPER.writeValueAsString(node.asText());
      } catch (IOException exception) {
        throw new IllegalArgumentException(exception.getMessage(), exception);
      }
    }
    if (node.isArray()) {
      List<String> values = new ArrayList<>();
      node.forEach(item -> values.add(canonicalJson(item)));
      return "[" + String.join(",", values) + "]";
    }
    List<String> keys = new ArrayList<>();
    Iterator<String> iterator = node.fieldNames();
    iterator.forEachRemaining(keys::add);
    keys.sort(MeshPack::compareUtf16);
    List<String> pairs = new ArrayList<>();
    for (String key : keys) {
      try {
        pairs.add(MAPPER.writeValueAsString(key) + ":" + canonicalJson(node.get(key)));
      } catch (IOException exception) {
        throw new IllegalArgumentException(exception.getMessage(), exception);
      }
    }
    return "{" + String.join(",", pairs) + "}";
  }

  private static int compareUtf16(String left, String right) {
    return left.compareTo(right);
  }

  private static int compareUtf8(String left, String right) {
    byte[] leftBytes = left.getBytes(StandardCharsets.UTF_8);
    byte[] rightBytes = right.getBytes(StandardCharsets.UTF_8);
    int length = Math.min(leftBytes.length, rightBytes.length);
    for (int index = 0; index < length; index++) {
      int comparison = Byte.compareUnsigned(leftBytes[index], rightBytes[index]);
      if (comparison != 0) {
        return comparison;
      }
    }
    return Integer.compare(leftBytes.length, rightBytes.length);
  }

  public static final class Reader implements AutoCloseable {
    private final ZipFile archive;

    public Reader(Path path) throws IOException {
      this.archive = new ZipFile(path.toFile());
    }

    public String readManifestJson() throws IOException {
      return readText("manifest.json");
    }

    public Manifest readManifest() throws IOException {
      return MAPPER.readValue(readManifestJson(), Manifest.class);
    }

    public List<String> readShardJsonDocuments() throws IOException {
      List<String> shards = new ArrayList<>();
      Manifest manifest = readManifest();
      if (manifest.shard_list() == null) {
        return shards;
      }
      for (ShardReference shardRef : manifest.shard_list()) {
        shards.add(readText("index/" + shardRef.id() + ".json"));
      }
      return shards;
    }

    public List<Shard> readShards() throws IOException {
      List<Shard> shards = new ArrayList<>();
      for (String shardJson : readShardJsonDocuments()) {
        shards.add(MAPPER.readValue(shardJson, Shard.class));
      }
      return shards;
    }

    public MeshPackDocument readDocument() throws IOException {
      Manifest manifest = readManifest();
      List<Shard> shards = readShards();
      List<FileEntry> entries = new ArrayList<>();
      for (Shard shard : shards) {
        if (shard.entries() != null) {
          entries.addAll(shard.entries());
        }
      }
      return new MeshPackDocument(manifest, shards, entries);
    }

    public List<String> listEntryNames() {
      return archive.stream().map(ZipEntry::getName).toList();
    }

    public Optional<byte[]> readResource(String resourceRef) throws IOException {
      if (resourceRef == null || resourceRef.isBlank()) {
        return Optional.empty();
      }
      if (!isSafeResourceRef(resourceRef)) {
        return Optional.empty();
      }
      ZipEntry entry = archive.getEntry("resources/" + resourceRef);
      return entry == null ? Optional.empty() : Optional.of(readBytes(entry));
    }

    private String readText(String entryName) throws IOException {
      ZipEntry entry = archive.getEntry(entryName);
      if (entry == null) {
        throw new IOException(entryName + " not found in archive");
      }
      return new String(readBytes(entry), StandardCharsets.UTF_8);
    }

    private byte[] readBytes(ZipEntry entry) throws IOException {
      return MeshPack.readBytes(archive, entry);
    }

    @Override
    public void close() throws IOException {
      archive.close();
    }
  }

  private static String readText(ZipFile archive, String entryName) throws IOException {
    ZipEntry entry = archive.getEntry(entryName);
    if (entry == null) {
      throw new IOException(entryName + " not found in archive");
    }
    return new String(readBytes(archive, entry), StandardCharsets.UTF_8);
  }

  private static byte[] readBytes(ZipFile archive, ZipEntry entry) throws IOException {
    try (InputStream input = archive.getInputStream(entry); ByteArrayOutputStream output = new ByteArrayOutputStream()) {
      input.transferTo(output);
      return output.toByteArray();
    }
  }

