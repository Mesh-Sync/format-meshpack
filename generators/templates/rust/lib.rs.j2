pub struct MeshPackReader {
    archive: ZipArchive<File>,
    manifest: Option<Manifest>,
    files: HashMap<String, FileEntry>,
    loaded: bool,
}

impl MeshPackReader {
    pub fn open<P: AsRef<Path>>(path: P) -> Result<Self, Box<dyn std::error::Error>> {
        let file = File::open(path)?;
        let archive = ZipArchive::new(file)?;
        Ok(Self { archive, manifest: None, files: HashMap::new(), loaded: false })
    }

    pub fn load_index(&mut self) -> Result<(), Box<dyn std::error::Error>> {
        if self.loaded {
            return Ok(());
        }

        {
            let mut manifest_file = self.archive.by_name("manifest.json")?;
            let mut content = String::new();
            manifest_file.read_to_string(&mut content)?;
            let manifest: Manifest = serde_json::from_str(&content)?;
            self.manifest = Some(manifest);
        }

        let shard_paths: Vec<String> = self.manifest.as_ref()
            .map(|manifest| manifest.shard_list.iter().map(|shard_ref| format!("index/{}.json", shard_ref.id)).collect())
            .unwrap_or_default();
        for name in shard_paths {
            let mut shard_file = self.archive.by_name(&name)?;
            let mut content = String::new();
            shard_file.read_to_string(&mut content)?;
            let shard: Shard = serde_json::from_str(&content)?;
            for entry in shard.entries {
                self.files.insert(entry.path.clone(), entry);
            }
        }

        self.loaded = true;
        Ok(())
    }

    pub fn get_manifest(&mut self) -> Result<&Manifest, Box<dyn std::error::Error>> {
        self.load_index()?;
        self.manifest.as_ref().ok_or_else(|| "manifest.json was not loaded".into())
    }

    pub fn get_file_entry(&mut self, path: &str) -> Result<Option<&FileEntry>, Box<dyn std::error::Error>> {
        self.load_index()?;
        Ok(self.files.get(path))
    }

    pub fn list_model_entries(&mut self) -> Result<Vec<&FileEntry>, Box<dyn std::error::Error>> {
        self.list_by_extension(&[".stl", ".obj", ".3mf", ".step", ".stp", ".ply", ".off"])
    }

    pub fn list_by_extension(&mut self, extensions: &[&str]) -> Result<Vec<&FileEntry>, Box<dyn std::error::Error>> {
        self.load_index()?;
        Ok(self.files.values().filter(|entry| {
            let lower = entry.path.to_lowercase();
            extensions.iter().any(|extension| lower.ends_with(extension))
        }).collect())
    }

    pub fn get_files_by_hash(&mut self, hash: &str) -> Result<Vec<&FileEntry>, Box<dyn std::error::Error>> {
        self.load_index()?;
        Ok(self.files.values().filter(|entry| entry.hash == hash).collect())
    }

    pub fn read_resource(&mut self, entry: &FileEntry) -> Result<Option<Vec<u8>>, Box<dyn std::error::Error>> {
        if let Some(resource_ref) = &entry.resource_ref {
            if !is_safe_resource_ref(resource_ref) {
                return Ok(None);
            }
            let path = format!("resources/{resource_ref}");
            let mut file = match self.archive.by_name(&path) {
                Ok(file) => file,
                Err(_) => return Ok(None),
            };
            let mut buffer = Vec::new();
            file.read_to_end(&mut buffer)?;
            Ok(Some(buffer))
        } else {
            Ok(None)
        }
    }
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ValidationFinding {
    pub severity: String,
    pub code: String,
    pub message: String,
}

#[derive(Debug, Clone, Default)]
pub struct ValidationResult {
    pub findings: Vec<ValidationFinding>,
}

#[derive(Debug, Clone, Default)]
pub struct ValidationOptions {
    pub sidecar_path: Option<PathBuf>,
    pub verify_signatures: bool,
}

impl ValidationResult {
    pub fn is_valid(&self) -> bool {
        !self.findings.iter().any(|finding| finding.severity == "ERROR")
    }

    pub fn errors(&self) -> Vec<&ValidationFinding> {
        self.findings.iter().filter(|finding| finding.severity == "ERROR").collect()
    }

    pub fn warnings(&self) -> Vec<&ValidationFinding> {
        self.findings.iter().filter(|finding| finding.severity == "WARNING").collect()
    }
}

pub fn validate_meshpack<P: AsRef<Path>>(path: P) -> Result<ValidationResult, Box<dyn std::error::Error>> {
    validate_meshpack_with_options(path, ValidationOptions::default())
}

pub fn validate_meshpack_with_options<P: AsRef<Path>>(
    path: P,
    options: ValidationOptions,
) -> Result<ValidationResult, Box<dyn std::error::Error>> {
    let mut result = ValidationResult::default();
    let path_ref = path.as_ref();
    let file = match File::open(path_ref) {
        Ok(file) => file,
        Err(error) => {
            result.findings.push(finding("ERROR", "ARC-001", format!("Cannot open archive: {error}")));
            return Ok(result);
        }
    };
    let mut archive = match ZipArchive::new(file) {
        Ok(archive) => archive,
        Err(error) => {
            result.findings.push(finding("ERROR", "ARC-001", format!("Cannot open archive: {error}")));
            return Ok(result);
        }
    };

    let mut names = Vec::new();
    let mut total_decompressed = 0_u64;
    for index in 0..archive.len() {
        let file = archive.by_index(index)?;
        let name = file.name().to_string();
        total_decompressed += file.size();
        if !matches!(file.compression(), CompressionMethod::Stored | CompressionMethod::Deflated) {
            result.findings.push(finding("ERROR", "ZIP-003", format!("Entry '{name}' uses unsupported compression method")));
        }
        if file.compressed_size() > 0 && file.size() / file.compressed_size() > 100 {
            result.findings.push(finding("ERROR", "ZIP-004", format!("Entry '{name}' exceeds compression ratio limit 100:1")));
        }
        names.push(name);
    }

    if names.first().map(|name| name.as_str()) != Some("manifest.json") && !names.is_empty() {
        result.findings.push(finding("WARNING", "ZIP-001", format!("manifest.json should be the first ZIP entry (found '{}' first)", names[0])));
    }
    if total_decompressed > 10 * 1024_u64.pow(3) {
        result.findings.push(finding("ERROR", "ZIP-005", "Total decompressed size exceeds limit of 10737418240 bytes"));
    }

    let names_set: HashSet<String> = names.iter().cloned().collect();
    validate_readme_layout(&mut archive, &names_set, &mut result.findings);
    if !names_set.contains("manifest.json") {
        result.findings.push(finding("ERROR", "MAN-001", "manifest.json not found in archive"));
        return Ok(result);
    }

    let mut manifest_content = String::new();
    archive.by_name("manifest.json")?.read_to_string(&mut manifest_content)?;
    let manifest: Manifest = match serde_json::from_str(&manifest_content) {
        Ok(manifest) => manifest,
        Err(error) => {
            result.findings.push(finding("ERROR", "MAN-002", format!("Failed to parse manifest.json: {error}")));
            return Ok(result);
        }
    };
    validate_format_version(&manifest.format_version, &mut result.findings);
    if !matches!(manifest.hash_algo.as_str(), "sha256" | "sha512" | "blake3") {
        result.findings.push(finding("ERROR", "MAN-012", format!("Unsupported hash_algo: '{}'", manifest.hash_algo)));
    }

    for shard_ref in &manifest.shard_list {
        let shard_path = format!("index/{}.json", shard_ref.id);
        if !is_shard_id(&shard_ref.id) {
            result.findings.push(finding("WARNING", "SHD-001", format!("shard_id '{}' does not match ^part-\\d{{5}}$", shard_ref.id)));
        }
        if !names_set.contains(&shard_path) {
            result.findings.push(finding("ERROR", "SHD-002", format!("Shard file missing in archive: {shard_path}")));
            continue;
        }

        let mut shard_content = String::new();
        archive.by_name(&shard_path)?.read_to_string(&mut shard_content)?;
        let shard: Shard = match serde_json::from_str(&shard_content) {
            Ok(shard) => shard,
            Err(error) => {
                result.findings.push(finding("ERROR", "SHD-003", format!("Failed to parse {shard_path}: {error}")));
                continue;
            }
        };
        let shard_value: Value = serde_json::from_str(&shard_content)?;
        let paths: Vec<&str> = shard.entries.iter().map(|entry| entry.path.as_str()).collect();
        let mut sorted_paths = paths.clone();
        sorted_paths.sort_unstable_by(|left, right| left.as_bytes().cmp(right.as_bytes()));
        if paths != sorted_paths {
            result.findings.push(finding("WARNING", "SHD-004", format!("Entries not sorted by UTF-8 path order in {shard_path}")));
        }
        if shard_ref.entries_count != shard.entries.len() as u64 {
            result.findings.push(finding("ERROR", "SHD-005", format!("entries_count mismatch in {shard_path}: expected {}, got {}", shard_ref.entries_count, shard.entries.len())));
        }
        if let Some(entries) = shard_value.get("entries").and_then(Value::as_array) {
            match compute_entries_hash(entries, &manifest.hash_algo) {
                Ok(actual) if actual != shard_ref.entries_hash => result.findings.push(finding("ERROR", "SHD-007", format!("entries_hash mismatch in {shard_path}: expected {}, got {actual}", shard_ref.entries_hash))),
                Err(error) => result.findings.push(finding("WARNING", "SHD-006", format!("Hash algo error in {shard_path}: {error}"))),
                _ => {}
            }
        }

        for entry in &shard.entries {
            validate_entry_path(&entry.path, &shard_path, &mut result.findings);
            if !is_hash_value(&entry.hash) {
                result.findings.push(finding("WARNING", "HSH-001", format!("Hash format invalid for {} in {shard_path}", entry.path)));
            }
            if let Some(resource_ref) = &entry.resource_ref {
                if entry.resource_hash.is_none() {
                    result.findings.push(finding("WARNING", "RES-001", format!("{shard_path}:{} has resource_ref but missing resource_hash", entry.path)));
                }
                validate_resource_ref(resource_ref, "resource_ref", &shard_path, &entry.path, &mut result.findings);
                if !names_set.contains(&format!("resources/{resource_ref}")) {
                    result.findings.push(finding("ERROR", "RES-002", format!("Missing embedded resource: resources/{resource_ref}")));
                }
            }
            if let Some(preview_ref) = &entry.preview_ref {
                validate_resource_ref(preview_ref, "preview_ref", &shard_path, &entry.path, &mut result.findings);
                if !names_set.contains(&format!("resources/{preview_ref}")) {
                    result.findings.push(finding("ERROR", "RES-002", format!("Missing embedded resource: resources/{preview_ref}")));
                }
            }
        }
    }

    verify_sidecar(path_ref, &manifest, options.sidecar_path.as_deref(), options.verify_signatures, &mut result.findings);

    Ok(result)
}

fn finding(severity: &str, code: &str, message: impl Into<String>) -> ValidationFinding {
    ValidationFinding { severity: severity.to_string(), code: code.to_string(), message: message.into() }
}

fn validate_format_version(format_version: &str, findings: &mut Vec<ValidationFinding>) {
    let parts: Vec<&str> = format_version.split('.').collect();
    if parts.len() != 3 || parts.iter().any(|part| part.is_empty() || !part.chars().all(|item| item.is_ascii_digit())) {
        findings.push(finding("WARNING", "MAN-011", format!("format_version '{format_version}' is not valid semver")));
        return;
    }
    let Ok(major) = parts[0].parse::<u64>() else {
        findings.push(finding("WARNING", "MAN-011", format!("format_version '{format_version}' is not valid semver")));
        return;
    };
    if major > SUPPORTED_FORMAT_MAJOR {
        findings.push(finding("ERROR", "MAN-013", format!("Unsupported format_version {format_version}; maximum supported major version is {SUPPORTED_FORMAT_MAJOR}.x.x")));
    }
}

fn validate_readme_layout(archive: &mut ZipArchive<File>, names_set: &HashSet<String>, findings: &mut Vec<ValidationFinding>) {
    if !names_set.contains("_README.md") {
        findings.push(finding("WARNING", "LAY-001", "Root _README.md is missing; L2 writers must include a human-readable root description."));
    }
    if names_set.iter().any(|name| name.starts_with("index/part-") && name.ends_with(".json")) && !names_set.contains("index/_README.md") {
        findings.push(finding("WARNING", "LAY-002", "index/_README.md is missing; L2 writers must document the sharded index directory."));
    }
    if names_set.iter().any(|name| name.starts_with("resources/") && name != "resources/_README.md") && !names_set.contains("resources/_README.md") {
        findings.push(finding("WARNING", "LAY-003", "resources/_README.md is missing while embedded resources are present."));
    }
    for readme_path in ["_README.md", "index/_README.md", "resources/_README.md"] {
        if !names_set.contains(readme_path) {
            continue;
        }
        let mut data = Vec::new();
        if let Ok(mut file) = archive.by_name(readme_path) {
            let _ = file.read_to_end(&mut data);
        }
        if data.contains(&b'\r') {
            findings.push(finding("ERROR", "LAY-004", format!("{readme_path} must use LF line endings, not CRLF/CR.")));
        }
    }
}

fn is_shard_id(value: &str) -> bool {
    value.len() == 10 && value.starts_with("part-") && value[5..].chars().all(|item| item.is_ascii_digit())
}

fn is_hash_value(value: &str) -> bool {
    let Some((algo, hex)) = value.split_once(':') else { return false; };
    let expected_len = match algo {
        "sha256" | "blake3" => 64,
        "sha512" => 128,
        _ => return false,
    };
    hex.len() == expected_len && hex.chars().all(|item| item.is_ascii_hexdigit() && !item.is_ascii_uppercase())
}

fn validate_entry_path(path: &str, shard_path: &str, findings: &mut Vec<ValidationFinding>) {
    if path.len() > 1024 {
        findings.push(finding("ERROR", "ENT-001", format!("Path exceeds 1024 chars in {shard_path}: {}...", &path[..80.min(path.len())])));
    }
    if path.split('/').any(|part| part == "..") {
        findings.push(finding("ERROR", "ENT-002", format!("Path traversal detected in {shard_path}: {path}")));
    }
    if path.starts_with('/') {
        findings.push(finding("ERROR", "ENT-003", format!("Absolute path in {shard_path}: {path}")));
    }
    if path.len() >= 2 && path.as_bytes()[0].is_ascii_alphabetic() && path.as_bytes()[1] == b':' {
        findings.push(finding("ERROR", "ENT-004", format!("Drive letter path in {shard_path}: {path}")));
    }
    if path.starts_with("\\\\") {
        findings.push(finding("ERROR", "ENT-005", format!("UNC path in {shard_path}: {path}")));
    }
}

fn is_safe_resource_ref(value: &str) -> bool {
    if value.contains('/') || value.contains('\\') || value.contains(':') {
        return false;
    }
    let Some((hex, extension)) = value.split_once('.') else { return false; };
    let hex_valid = (hex.len() == 64 || hex.len() == 128)
        && hex.chars().all(|item| item.is_ascii_hexdigit() && !item.is_ascii_uppercase());
    let extension_valid = !extension.is_empty()
        && extension.len() <= 32
        && extension.chars().all(|item| item.is_ascii_alphanumeric() || item == '.' || item == '_' || item == '-');
    hex_valid && extension_valid
}

fn validate_resource_ref(
    resource_ref: &str,
    field_name: &str,
    shard_path: &str,
    entry_path: &str,
    findings: &mut Vec<ValidationFinding>,
) {
    if resource_ref.contains(':') {
        findings.push(finding("WARNING", "RES-003", format!("{field_name} contains ':' in {shard_path}:{entry_path}")));
    }
    if !is_safe_resource_ref(resource_ref) {
        findings.push(finding("ERROR", "RES-004", format!("Unsafe or non-canonical {field_name} in {shard_path}:{entry_path}: {resource_ref}")));
    }
}

fn verify_sidecar(
    meshpack_path: &Path,
    manifest: &Manifest,
    sidecar_path: Option<&Path>,
    verify_signatures: bool,
    findings: &mut Vec<ValidationFinding>,
) {
    let auto_path = PathBuf::from(format!("{}.integrity", meshpack_path.to_string_lossy()));
    let sidecar_path = sidecar_path.or_else(|| auto_path.exists().then_some(auto_path.as_path()));
    let Some(sidecar_path) = sidecar_path else {
        findings.push(finding("INFO", "SDC-001", "No .meshpack.integrity sidecar found; skipping pack-level hash verification."));
        return;
    };

    let sidecar_content = match fs::read_to_string(sidecar_path) {
        Ok(content) => content,
        Err(error) => {
            findings.push(finding("ERROR", "SDC-002", format!("Failed to load sidecar: {error}")));
            return;
        }
    };
    let sidecar: Sidecar = match serde_json::from_str(&sidecar_content) {
        Ok(sidecar) => sidecar,
        Err(error) => {
            findings.push(finding("ERROR", "SCH-001", format!("Sidecar schema validation failed: {error}")));
            return;
        }
    };

    if let Some(file_name) = meshpack_path.file_name().and_then(|item| item.to_str()) {
        if sidecar.pack_name != file_name {
            findings.push(finding("ERROR", "SDC-006", format!("Sidecar pack_name mismatch: sidecar expects {}, archive is {file_name}", sidecar.pack_name)));
        }
    }

    match fs::metadata(meshpack_path) {
        Ok(metadata) if metadata.len() != sidecar.pack_size_bytes => findings.push(finding("ERROR", "SDC-007", format!("Sidecar pack_size_bytes mismatch: sidecar expects {}, archive is {}", sidecar.pack_size_bytes, metadata.len()))),
        Err(error) => findings.push(finding("WARNING", "SDC-004", format!("Failed to read archive metadata: {error}"))),
        _ => {}
    }

    if sidecar.hash_algo != manifest.hash_algo {
        findings.push(finding("ERROR", "SDC-008", format!("Sidecar hash_algo mismatch: sidecar uses {}, manifest uses {}", sidecar.hash_algo, manifest.hash_algo)));
    }

    let archive_bytes = match fs::read(meshpack_path) {
        Ok(bytes) => bytes,
        Err(error) => {
            findings.push(finding("WARNING", "SDC-004", format!("Failed to read archive bytes: {error}")));
            return;
        }
    };
    let digest = match compute_digest_hex(&archive_bytes, &sidecar.hash_algo) {
        Ok(digest) => digest,
        Err(error) => {
            findings.push(finding("WARNING", "SDC-004", error));
            return;
        }
    };
    let actual = if sidecar.pack_hash.contains(':') { format!("{}:{digest}", sidecar.hash_algo) } else { digest };
    if actual != sidecar.pack_hash {
        findings.push(finding("ERROR", "SDC-005", format!("Pack hash mismatch: sidecar expects {}, computed {actual}", sidecar.pack_hash)));
    } else {
        findings.push(finding("INFO", "SDC-010", "Pack hash verified successfully via sidecar."));
    }

    if let Some(signatures) = &sidecar.signatures {
        if !signatures.is_empty() && verify_signatures {
            findings.extend(verify_signature_entries(signatures, &sidecar.pack_hash));
        } else if !signatures.is_empty() {
            findings.push(finding("INFO", "SDC-011", format!("Sidecar contains {} signature(s). Enable signature verification to check them.", signatures.len())));
        }
    }
}

fn verify_signature_entries(signatures: &[SignatureEntry], pack_hash: &str) -> Vec<ValidationFinding> {
    let mut findings = Vec::new();
    for (index, signature_entry) in signatures.iter().enumerate() {
        let signer = signature_entry.signer_id.as_deref().unwrap_or("signature");
        let signer = if signer == "signature" { format!("signature[{index}]") } else { signer.to_string() };
        let public_key_bytes = match BASE64.decode(&signature_entry.public_key) {
            Ok(bytes) => bytes,
            Err(error) => {
                findings.push(finding("ERROR", "SIG-003", format!("{signer}: invalid base64 encoding - {error}")));
                continue;
            }
        };
        let signature_bytes = match BASE64.decode(&signature_entry.signature) {
            Ok(bytes) => bytes,
            Err(error) => {
                findings.push(finding("ERROR", "SIG-003", format!("{signer}: invalid base64 encoding - {error}")));
                continue;
            }
        };

        if signature_entry.alg == "ed25519" {
            let key_bytes = if public_key_bytes.len() == 32 {
                public_key_bytes.as_slice()
            } else if public_key_bytes.len() > 32 {
                &public_key_bytes[public_key_bytes.len() - 32..]
            } else {
                findings.push(finding("ERROR", "SIG-004", format!("{signer}: Ed25519 public key must be 32 bytes")));
                continue;
            };
            let key_array: [u8; 32] = match key_bytes.try_into() {
                Ok(bytes) => bytes,
                Err(_) => {
                    findings.push(finding("ERROR", "SIG-004", format!("{signer}: Ed25519 public key must be 32 bytes")));
                    continue;
                }
            };
            let key = match VerifyingKey::from_bytes(&key_array) {
                Ok(key) => key,
                Err(error) => {
                    findings.push(finding("ERROR", "SIG-004", format!("{signer}: Ed25519 public key failed to load - {error}")));
                    continue;
                }
            };
            let signature = match Ed25519Signature::from_slice(&signature_bytes) {
                Ok(signature) => signature,
                Err(error) => {
                    findings.push(finding("ERROR", "SIG-004", format!("{signer}: Ed25519 signature failed to load - {error}")));
                    continue;
                }
            };
            if key.verify(pack_hash.as_bytes(), &signature).is_ok() {
                findings.push(finding("INFO", "SIG-010", format!("{signer}: Ed25519 signature verified successfully")));
            } else {
                findings.push(finding("ERROR", "SIG-004", format!("{signer}: Ed25519 signature verification failed")));
            }
        } else {
            findings.push(finding("INFO", "SIG-005", format!("{signer}: unsupported algorithm '{}' - skipped", signature_entry.alg)));
        }
    }
    findings
}

fn compute_entries_hash(entries: &[Value], algo: &str) -> Result<String, String> {
    let mut sorted_entries = entries.to_vec();
    sorted_entries.sort_by(|left, right| {
        let left_path = left.get("path").and_then(Value::as_str).unwrap_or_default();
        let right_path = right.get("path").and_then(Value::as_str).unwrap_or_default();
        left_path.as_bytes().cmp(right_path.as_bytes())
    });
    let encoded = canonical_json(&Value::Array(sorted_entries));
    let digest = compute_digest_hex(encoded.as_bytes(), algo)?;
    Ok(format!("{algo}:{digest}"))
}

fn compute_digest_hex(bytes: &[u8], algo: &str) -> Result<String, String> {
    match algo {
        "sha256" => Ok(format!("{:x}", Sha256::digest(bytes))),
        "sha512" => Ok(format!("{:x}", Sha512::digest(bytes))),
        "blake3" => Ok(blake3::hash(bytes).to_hex().to_string()),
        _ => Err(format!("Unsupported hash algorithm: {algo}")),
    }
}

fn canonical_json(value: &Value) -> String {
    match value {
        Value::Null => "null".to_string(),
        Value::Bool(item) => item.to_string(),
        Value::Number(item) => item.to_string(),
        Value::String(item) => serde_json::to_string(item).unwrap_or_else(|_| "\"\"".to_string()),
        Value::Array(items) => format!("[{}]", items.iter().map(canonical_json).collect::<Vec<_>>().join(",")),
        Value::Object(map) => {
            let mut keys: Vec<&String> = map.keys().collect();
            keys.sort_unstable_by_key(|key| utf16_sort_key((*key).as_str()));
            let pairs = keys.into_iter().map(|key| {
                format!("{}:{}", serde_json::to_string(key).unwrap_or_default(), canonical_json(&map[key]))
            }).collect::<Vec<_>>();
            let mut encoded = String::from("{");
            encoded.push_str(&pairs.join(","));
            encoded.push('}');
            encoded
        }
    }
}

fn utf16_sort_key(value: &str) -> Vec<u16> {
    value.encode_utf16().collect()
}

