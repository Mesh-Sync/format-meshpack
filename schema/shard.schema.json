{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meshsync.net/schemas/mpack/shard.json",
  "title": "MeshPack Index Shard",
  "description": "Sharded file index containing a subset of file entries",
  "type": "object",
  "required": ["shard_id", "format_version", "entries"],
  "properties": {
    "shard_id": {
      "type": "string"
    },
    "format_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "creator_info": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/fileEntry"
      }
    }
  },
  "definitions": {
    "fileEntry": {
      "type": "object",
      "required": ["path", "original_name", "size_bytes", "hash", "modified_at"],
      "properties": {
        "path": { 
          "type": "string",
          "description": "Relative path from root, POSIX separators"
        },
        "original_name": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "hash": { 
          "type": "string",
          "pattern": "^[a-z0-9]+:[a-f0-9]+$" 
        },
        "modified_at": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "mime_type": { "type": "string" },
        "resource_ref": { 
            "type": ["string", "null"],
            "description": "If not null, corresponds to a file in resources/<hash>.<ext>"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "is_symlink": { "type": "boolean" },
            "is_hidden": { "type": "boolean" }
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
