{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meshsync.net/schemas/meshpack/extensions/meshsync_dependencies.json",
  "title": "MeshSync Dependencies Extension",
  "description": "File dependencies for multi-file formats (OBJ+MTL, FBX with textures)",
  "type": "object",
  "properties": {
    "v1": {
      "type": "object",
      "description": "Version 1 of the dependencies extension schema",
      "properties": {
        "materials": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative paths to material files (e.g., .mtl)"
        },
        "textures": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative paths to texture files"
        },
        "references": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative paths to other referenced model files"
        }
      }
    }
  },
  "additionalProperties": true
}
