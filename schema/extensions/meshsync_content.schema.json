{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meshsync.net/schemas/meshpack/1.1/extensions/meshsync_content.schema.json",
  "title": "MeshSync Content Extension",
  "description": "Rich content metadata for marketplace listings and display",
  "type": "object",
  "properties": {
    "v1": {
      "type": "object",
      "description": "Version 1 of the content extension schema",
      "properties": {
        "title": {
          "type": "string",
          "description": "Human-readable title for the model or asset"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the model or asset"
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag (e.g., 'en', 'fr', 'de')",
          "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keywords for search and categorization"
        }
      },
      "required": ["title", "description", "language", "tags"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
