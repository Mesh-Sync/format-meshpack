# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.json]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{ts,js}]
indent_size = 2

[*.{rs,toml}]
indent_size = 4

[*.j2]
indent_size = 2

[Justfile]
indent_size = 4

[*.yaml]
indent_size = 2
